#!/bin/bash

# Check that the script was invoked with the correct number of arguments
if [ "$#" -ne 3 ]; then
  echo "Usage: $0 <input_file> <output_file>"
  exit 1
fi

input_file_name="$1/$2"
output_file_name="$1/$3"

cp $2 $3

# loop through the lines in the file
sed '/^$/d' $input_file_name | awk '/^[-]/ {print $0}' | while read line; do
  # extract the list item and convert to link label
  label=${line:2}
  label=${label%$'\r'}
  link_label=$(echo "$label" | awk '{print tolower($0)}' | sed 's/ /_/g')

  # create the link and replace the list item in the line
  # # Escape special characters with sed
  # myvar_escaped=$(echo "$myvar" | sed 's/[\/$*.]/\\&/g')
  touch "$1/gen_$link_label.md"
  link="[$label](gen_$link_label.md)"
  line=${line/- /$link}


  # replace the line in the file
  sed -i '.bak' "s/${label}/${link}/g" $input_file_name

done

backup_file_name=${input_file_name}.bak
mv $output_file_name $backup_file_name
mv $input_file_name $output_file_name
mv $backup_file_name $input_file_name
