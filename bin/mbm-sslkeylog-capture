#!/usr/bin/env bash
# mbm-sslkeylog-capture - record a browser session as a packet capture together with the TLS keys that decrypt it
#
# Starts a separate Chrome or Firefox with SSLKEYLOGFILE set and, at the same time, a tshark
# capture. Both run until you press Enter or Ctrl-C (or for -d SECONDS); then the capture
# and that browser are stopped. The browser runs on a profile folder of its own, apart from
# your everyday browser, and only the instance started here is ever stopped.
#
# Usage:
#   mbm-sslkeylog-capture [-b chrome|firefox] [-i INTERFACE | -r] [-f FILTER] [-d SECONDS] [-o DIR]
#
# Options:
#   -b BROWSER             chrome or firefox (default: asks on a terminal, otherwise chrome)
#   -i INTERFACE           capture on this interface (default: the one of the default route)
#   -r                     capture on all interfaces (tshark -i any)
#   -f FILTER              a capture filter for tshark, for example 'tcp port 443'
#   -d SECONDS             stop by itself after this many seconds (0: wait for Enter)
#   -o DIR, --output DIR   the folder for the results (default: see Settings)
#   -h, --help             show this help
#
# Results, under DIR:
#   logs/sslkeys/session-<time>.log   the TLS keys - whoever has them can decrypt the capture
#   ldumps/session-<time>.pcapng      the capture
#   logs/browser-profiles/            the profile folders of the browsers started here
#
# Examples:
#   mbm-sslkeylog-capture
#   mbm-sslkeylog-capture -b firefox
#   mbm-sslkeylog-capture -b chrome -i en0 -f 'tcp port 443'
#   mbm-sslkeylog-capture -b chrome -d 60
#   mbm-sslkeylog-capture -r -o ~/captures
#
# To read a session: open the .pcapng in Wireshark and set Preferences > Protocols > TLS >
# "(Pre)-Master-Secret log filename" to the .log file. Or on the command line:
#   tshark -r session.pcapng -o tls.keylog_file:session.log -Y http
#
# Needs: tshark that may capture (brew install wireshark; on macOS the ChmodBPF package of
#   the Wireshark installer gives the permission), and Chrome, Chromium or Firefox.
#   macOS and Linux.
# Settings:
#   MBM_SSLKEYLOG_DIR       where the results go (default: ~/.local/share/sslkeylog-capture)
#   MBM_SSLKEYLOG_CHROME    the Chrome or Chromium program (default: Google Chrome in
#                           /Applications, else google-chrome or chromium on the PATH)
#   MBM_SSLKEYLOG_FIREFOX   the Firefox program (default: Firefox in /Applications, else
#                           firefox on the PATH)
# Exit status: 0 the session was recorded, 1 it could not start or the capture stopped early,
#   2 wrong usage.

set -u
ME="${0##*/}"
SELF="$0"
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF" | sed "s/mbm-/${ME%sslkeylog-capture}/g"; }
die() { echo "$ME: $*" >&2; exit 1; }
bad_usage() { echo "$ME: $* (see: $ME --help)" >&2; exit 2; }

BASE="${MBM_SSLKEYLOG_DIR:-$HOME/.local/share/sslkeylog-capture}"
BROWSER=""          # chrome | firefox | "" (ask)
IFACE=""            # "" -> the interface of the default route; "any" with -r
CAPFILTER=""
DURATION=""         # "" -> until Enter or Ctrl-C

# ------------------------------------------------------------------ options
while getopts ":b:i:f:d:o:rh-:" opt; do
  case "$opt" in
    b) BROWSER="$OPTARG" ;;
    i) IFACE="$OPTARG" ;;
    f) CAPFILTER="$OPTARG" ;;
    d) DURATION="$OPTARG" ;;
    o) BASE="$OPTARG" ;;
    r) IFACE="any" ;;
    h) usage; exit 0 ;;
    -) case "$OPTARG" in          # the long options
         help) usage; exit 0 ;;
         output=*) BASE="${OPTARG#*=}" ;;
         output) [ "$OPTIND" -le $# ] || bad_usage "--output needs a folder"
                 BASE="${!OPTIND}"; OPTIND=$((OPTIND + 1)) ;;
         *) bad_usage "unknown option: --$OPTARG" ;;
       esac ;;
    :) bad_usage "option -$OPTARG needs a value" ;;
    *) bad_usage "unknown option: -$OPTARG" ;;
  esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] || bad_usage "unexpected argument: $1"
case "$BROWSER" in ''|chrome|firefox) ;; *) bad_usage "-b takes chrome or firefox, got: $BROWSER" ;; esac
case "$DURATION" in *[!0-9]*) bad_usage "-d takes a whole number of seconds, got: $DURATION" ;; esac
[ "${DURATION:-0}" -gt 0 ] || DURATION=""
[ -n "$BASE" ] || bad_usage "the folder for the results is empty"
case "$BASE" in /*) ;; *) BASE="$PWD/$BASE" ;; esac

# ------------------------------------------------------------------ checks
command -v tshark >/dev/null 2>&1 || die "tshark is not installed (macOS: brew install wireshark; Linux: apt install tshark)"

if [ -z "$BROWSER" ]; then
  BROWSER=chrome
  if [ -t 0 ]; then
    echo "Which browser?"
    echo "  1) Chrome"
    echo "  2) Firefox"
    read -r -p "Choice [1]: " choice || choice=""
    case "${choice:-1}" in
      1|chrome|Chrome)   BROWSER=chrome ;;
      2|firefox|Firefox) BROWSER=firefox ;;
      *) die "no such choice: $choice" ;;
    esac
  fi
fi

# The browser program: the setting when there is one, else the usual places.
if [ "$BROWSER" = chrome ]; then
  SETTING=MBM_SSLKEYLOG_CHROME
  CANDIDATES=("/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" google-chrome google-chrome-stable chromium chromium-browser)
else
  SETTING=MBM_SSLKEYLOG_FIREFOX
  CANDIDATES=("/Applications/Firefox.app/Contents/MacOS/firefox" firefox)
fi
[ -n "${!SETTING:-}" ] && CANDIDATES=("${!SETTING}")
BIN=""
for c in "${CANDIDATES[@]}"; do
  p="$(command -v "$c" 2>/dev/null)" && [ -f "$p" ] && [ -x "$p" ] && { BIN="$p"; break; }
done
if [ -z "$BIN" ]; then
  [ -n "${!SETTING:-}" ] && die "$SETTING names a program that is not there: ${!SETTING}"
  die "$BROWSER was not found; set $SETTING to the program to start"
fi

# No interface named: the one of the default route - asked the macOS way, then the Linux
# way. When neither answers, tshark takes its own first interface.
if [ -z "$IFACE" ]; then
  IFACE="$(route -n get default 2>/dev/null | awk '/interface:/ { print $2; exit }')"
  [ -n "$IFACE" ] || IFACE="$(ip -o route show default 2>/dev/null |
    awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')"
fi

# The browser runs on this profile folder and on no other. PATTERN finds the processes
# started on it and nothing else: pgrep and pkill take a regular expression, so the folder
# name is escaped to stand for itself.
PROFILE="$BASE/logs/browser-profiles/$BROWSER"
escaped="$(printf '%s' "$PROFILE" | sed 's/[][\.*^$+?(){}|]/\\&/g')"
if [ "$BROWSER" = chrome ]; then PATTERN="user-data-dir=$escaped"; else PATTERN="$escaped"; fi
if pgrep -f -- "$PATTERN" >/dev/null 2>&1; then
  die "a $BROWSER of an earlier session still runs on $PROFILE - close it first (it would keep writing its keys to the old file)"
fi

umask 077   # the key log decrypts the capture: keep both to yourself
mkdir -p "$BASE/logs/sslkeys" "$BASE/ldumps" "$PROFILE" || die "cannot create the folders under $BASE"
TS="$(date +%Y%m%d-%H%M%S)"
KEYLOG="$BASE/logs/sslkeys/session-$TS.log"
PCAP="$BASE/ldumps/session-$TS.pcapng"

# ------------------------------------------------------------------ stopping
BROWSER_PID=""
TSHARK_PID=""
SLEEP_PID=""
STOPPING=0
FROM_TERMINAL=0     # 1: stopped by Ctrl-C or by closing the terminal

stop_pid() {   # stop_pid PID - ask it to end, wait up to 3 seconds, then force it
  local i=0
  kill -0 "$1" 2>/dev/null || return 0
  kill -TERM "$1" 2>/dev/null
  while [ "$i" -lt 30 ] && kill -0 "$1" 2>/dev/null; do sleep 0.1; i=$((i + 1)); done
  kill -0 "$1" 2>/dev/null && kill -KILL "$1" 2>/dev/null
  wait "$1" 2>/dev/null
  return 0
}

cleanup() {
  local status=0
  [ "$STOPPING" = 1 ] && return
  STOPPING=1
  trap '' INT TERM HUP
  echo
  echo "Stopping the session ..."
  [ -n "$SLEEP_PID" ] && kill "$SLEEP_PID" 2>/dev/null

  if [ -n "$TSHARK_PID" ]; then
    if kill -0 "$TSHARK_PID" 2>/dev/null; then
      stop_pid "$TSHARK_PID"     # TERM lets tshark finish the pcapng file properly
      echo "  capture stopped"
    elif [ "$FROM_TERMINAL" = 1 ]; then
      echo "  capture stopped"     # tshark got the same Ctrl-C and has finished already
    else
      echo "$ME: the capture had already stopped by itself - the file is incomplete" >&2
      status=1
    fi
  fi

  if [ -n "$BROWSER_PID" ]; then
    stop_pid "$BROWSER_PID"
    pkill -f -- "$PATTERN" 2>/dev/null    # helper processes of that same instance
    echo "  browser stopped"
  fi
  wait 2>/dev/null

  echo
  echo "Session finished"
  if [ -s "$KEYLOG" ]; then
    echo "  TLS keys: $KEYLOG ($(wc -l < "$KEYLOG" | tr -d ' ') line(s))"
  else
    echo "  TLS keys: none written - the browser made no TLS connection"
  fi
  if [ -s "$PCAP" ]; then
    echo "  Capture:  $PCAP ($(du -h "$PCAP" | cut -f1))"
  else
    echo "  Capture:  empty"
  fi
  if [ -s "$KEYLOG" ] && [ -s "$PCAP" ]; then
    echo
    echo "To decrypt: open the capture in Wireshark and set Preferences > Protocols > TLS >"
    echo "\"(Pre)-Master-Secret log filename\" to the TLS keys file."
  fi
  exit "$status"
}
trap 'FROM_TERMINAL=1; cleanup' INT HUP   # the terminal sends these to tshark and the browser too
trap cleanup TERM EXIT

# ------------------------------------------------------------------ capture
echo "Browser:   $BROWSER ($BIN)"
echo "Interface: ${IFACE:-the first one tshark finds}"
[ -n "$CAPFILTER" ] && echo "Filter:    $CAPFILTER"
echo "TLS keys:  $KEYLOG"
echo "Capture:   $PCAP"
echo

TSHARK_ARGS=(-w "$PCAP" -s 0 -q)
[ -n "$IFACE" ] && TSHARK_ARGS=(-i "$IFACE" "${TSHARK_ARGS[@]}")
[ -n "$CAPFILTER" ] && TSHARK_ARGS+=(-f "$CAPFILTER")
tshark "${TSHARK_ARGS[@]}" 2> >(sed 's/^/[tshark] /' >&2) &
TSHARK_PID=$!

sleep 1
if ! kill -0 "$TSHARK_PID" 2>/dev/null; then
  # Nothing else runs yet: no session to stop, nothing to keep.
  trap - INT TERM HUP EXIT
  [ -s "$PCAP" ] || rm -f -- "$PCAP"
  die "tshark could not start the capture (its message is above). Without the permission to capture: on macOS install ChmodBPF (it comes with the Wireshark installer), on Linux join the wireshark group."
fi
echo "Capture started (tshark, process $TSHARK_PID)"

# ------------------------------------------------------------------ browser
# A running browser does not pick up SSLKEYLOGFILE, so this is a fresh one: Chrome on its
# own --user-data-dir, Firefox with -no-remote on its own profile.
export SSLKEYLOGFILE="$KEYLOG"
if [ "$BROWSER" = chrome ]; then
  "$BIN" --user-data-dir="$PROFILE" --no-first-run --no-default-browser-check \
    --new-window "about:blank" >/dev/null 2>&1 &
else
  "$BIN" -no-remote -profile "$PROFILE" -new-instance >/dev/null 2>&1 &
fi
BROWSER_PID=$!
echo "Browser started (process $BROWSER_PID)"
echo

# ------------------------------------------------------------------ wait
if [ -n "$DURATION" ]; then
  echo "Recording for $DURATION seconds (Ctrl-C stops earlier)."
  sleep "$DURATION" &      # in the background, so that Ctrl-C and a TERM signal act at once
  SLEEP_PID=$!
  wait "$SLEEP_PID"
else
  printf 'Recording. Browse now, then press Enter (or Ctrl-C) to stop the browser and the capture: '
  if ! read -r _; then
    echo "(standard input is closed: waiting for the browser to be closed)"
    wait "$BROWSER_PID"
  fi
fi
cleanup
