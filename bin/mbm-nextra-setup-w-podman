}
EOF

# Create Dockerfile for production
print_status "Creating Dockerfile..."
cat > Dockerfile << 'EOF'
FROM node:18-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Install dependencies
COPY package.json package-lock.json* ./
RUN npm ci

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npm run build

# Production image, copy all the files and run next
FROM base AS runner
WORKDIR /app

ENV NODE_ENV production
ENV NEXT_TELEMETRY_DISABLED 1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public

# Set the correct permission for prerender cache
RUN mkdir .next
RUN chown nextjs:nodejs .next

# Automatically leverage output traces to reduce image size
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT 3000
ENV HOSTNAME "0.0.0.0"

CMD ["node", "server.js"]
EOF

# Create nginx configuration
print_status "Creating nginx configuration..."
cat > nginx.conf << 'EOF'
server {
    listen 80;
    server_name localhost;

    location / {
        proxy_pass http://nextra-docs:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
EOF

# Create .dockerignore
cat > .dockerignore << 'EOF'
node_modules
.next
.git
.gitignore
README.md
.env*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
EOF

# Create Podman-specific run script
print_status "Creating podman-run.sh script..."
cat > podman-run.sh << 'EOF'
#!/bin/bash

# Pure Podman run script for Nextra documentation
# No Docker or Docker Compose dependencies

set -e

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

# Function to check if Podman is installed and detect OS
check_podman() {
    if ! command -v podman &> /dev/null; then
        echo "Error: Podman is not installed or not in PATH"
        echo "Please install Podman first: https://podman.io/getting-started/installation"
        exit 1
    fi
    
    # Detect operating system
    OS_TYPE=$(uname -s)
    case "$OS_TYPE" in
        "Darwin")
            IS_MACOS=true
            print_info "Detected macOS - using native Podman commands"
            ;;
        "Linux")
            IS_MACOS=false
            print_info "Detected Linux - using native Podman commands"
            ;;
        *)
            IS_MACOS=false
            print_warning "Unknown OS: $OS_TYPE, using native Podman commands"
            ;;
    esac
    
    print_info "Using native Podman commands for maximum compatibility"
}

# Function to setup SELinux if needed
setup_selinux() {
    if [ "$IS_MACOS" = true ]; then
        print_info "macOS detected - SELinux configuration not needed"
        SELINUX_FLAG=""
        return
    fi
    
    if command -v getenforce &> /dev/null && [[ $(getenforce) == "Enforcing" ]]; then
        print_info "SELinux is enforcing. Volume mounts will use :Z flag for compatibility."
        SELINUX_FLAG=":Z"
    else
        SELINUX_FLAG=""
    fi
}

# Function to run native podman commands
run_podman_service() {
    local mode=$1
    
    print_info "Starting Nextra with native Podman commands..."
    
    # Create network if it doesn't exist
    if ! podman network exists nextra-network 2>/dev/null; then
        print_info "Creating network: nextra-network"
        podman network create nextra-network
    fi
    
    # Stop and remove existing container if it exists
    if podman ps -a --format "{{.Names}}" | grep -q "^nextra-docs$"; then
        print_info "Stopping existing nextra-docs container..."
        podman stop nextra-docs 2>/dev/null || true
        podman rm nextra-docs 2>/dev/null || true
    fi
    
    # Set up volume strategy based on OS
    if [ "$IS_MACOS" = true ]; then
        # For macOS, use a different approach to avoid permission issues
        # Run as root initially to install packages, then copy files
        
        print_info "Using macOS-optimized container setup..."
        
        # First, install dependencies in a temporary container
        print_info "Installing dependencies..."
        podman run --rm \
            -v .:/workspace \
            -w /workspace \
            node:18-alpine \
            sh -c "cp package.json /tmp/ && cd /tmp && npm install && cp -r node_modules /workspace/"
        
        # Now run the main container with proper user mapping
        VOLUME_ARGS="-v .:/app --userns=keep-id"
        USER_ARGS="--user $(id -u):$(id -g)"
        
    else
        # On Linux, use named volumes for better performance
        if ! podman volume exists nextra-node-modules 2>/dev/null; then
            print_info "Creating volume: nextra-node-modules"
            podman volume create nextra-node-modules
        fi
        
        if ! podman volume exists nextra-next-cache 2>/dev/null; then
            print_info "Creating volume: nextra-next-cache"
            podman volume create nextra-next-cache
        fi
        
        VOLUME_ARGS="-v .:/app${SELINUX_FLAG} -v nextra-node-modules:/app/node_modules -v nextra-next-cache:/app/.next"
        USER_ARGS=""
        print_info "Using named volumes for Linux performance"
    fi
    
    # Run the container
    print_info "Starting nextra-docs container..."
    
    if [ "$mode" = "detached" ]; then
        podman run -d \
            --name nextra-docs \
            --network nextra-network \
            -p 3000:3000 \
            $VOLUME_ARGS \
            $USER_ARGS \
            -w /app \
            -e NODE_ENV=development \
            -e NEXT_TELEMETRY_DISABLED=1 \
            --restart unless-stopped \
            node:18-alpine \
            sh -c "npm run dev"
        
        print_success "Nextra started in background"
        print_info "View logs with: podman logs -f nextra-docs"
    else
        podman run -it --rm \
            --name nextra-docs \
            --network nextra-network \
            -p 3000:3000 \
            $VOLUME_ARGS \
            $USER_ARGS \
            -w /app \
            -e NODE_ENV=development \
            -e NEXT_TELEMETRY_DISABLED=1 \
            node:18-alpine \
            sh -c "npm run dev"
    fi
}

# Function to start nginx service (production mode)
start_nginx_service() {
    print_info "Starting nginx proxy service..."
    
    # Stop and remove existing nginx container if it exists
    if podman ps -a --format "{{.Names}}" | grep -q "^nextra-nginx$"; then
        print_info "Stopping existing nextra-nginx container..."
        podman stop nextra-nginx 2>/dev/null || true
        podman rm nextra-nginx 2>/dev/null || true
    fi
    
    # Set up nginx volume mount based on OS
    if [ "$IS_MACOS" = true ]; then
        NGINX_VOLUME="-v ./nginx.conf:/etc/nginx/conf.d/default.conf"
    else
        NGINX_VOLUME="-v ./nginx.conf:/etc/nginx/conf.d/default.conf${SELINUX_FLAG}"
    fi
    
    podman run -d \
        --name nextra-nginx \
        --network nextra-network \
        -p 8080:80 \
        $NGINX_VOLUME \
        nginx:alpine
    
    print_success "Nginx started on port 8080"
}

# Function to start development server
start_dev() {
    print_info "Starting Nextra development server with Podman..."
    check_podman
    setup_selinux
    
    run_podman_service "interactive"
}

# Function to start in background
start_detached() {
    print_info "Starting Nextra in detached mode..."
    check_podman
    setup_selinux
    
    run_podman_service "detached"
    print_info "Access at: http://localhost:3000"
}

# Function to start production mode
start_production() {
    print_info "Starting Nextra with nginx proxy..."
    check_podman
    setup_selinux
    
    # Start nextra service first
    run_podman_service "detached"
    
    # Wait a moment for nextra to start
    sleep 2
    
    # Start nginx proxy
    start_nginx_service
    
    print_success "Production setup complete!"
    print_info "Access Nextra directly at: http://localhost:3000"
    print_info "Access via nginx proxy at: http://localhost:8080"
}

# Function to stop services
stop_services() {
    print_info "Stopping Nextra services..."
    check_podman
    
    # Stop nextra container
    if podman ps --format "{{.Names}}" | grep -q "^nextra-docs$"; then
        print_info "Stopping nextra-docs..."
        podman stop nextra-docs
        podman rm nextra-docs 2>/dev/null || true
    fi
    
    # Stop nginx container
    if podman ps --format "{{.Names}}" | grep -q "^nextra-nginx$"; then
        print_info "Stopping nextra-nginx..."
        podman stop nextra-nginx
        podman rm nextra-nginx 2>/dev/null || true
    fi
    
    print_success "Services stopped"
}

# Function to show logs
show_logs() {
    check_podman
    
    if podman ps --format "{{.Names}}" | grep -q "^nextra-docs$"; then
        print_info "Showing logs for nextra-docs..."
        podman logs -f nextra-docs
    else
        print_warning "nextra-docs container not running"
        print_info "Available containers:"
        podman ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
    fi
}

# Function to rebuild and restart
rebuild() {
    print_info "Rebuilding and restarting..."
    check_podman
    
    # Stop services
    stop_services
    
    # Clean up any existing images
    if podman images --format "{{.Repository}}:{{.Tag}}" | grep -q "node:18-alpine"; then
        print_info "Pulling latest node:18-alpine image..."
        podman pull node:18-alpine
    fi
    
    # Restart in detached mode
    start_detached
}

# Function to clean up volumes
cleanup() {
    print_info "Cleaning up Podman resources..."
    check_podman
    
    # Stop and remove containers
    stop_services
    
    # Remove network
    if podman network exists nextra-network 2>/dev/null; then
        print_info "Removing network: nextra-network"
        podman network rm nextra-network 2>/dev/null || true
    fi
    
    # Clean up based on OS
    if [ "$IS_MACOS" = true ]; then
        # Remove local cache directories
        if [ -d "./node_modules_cache" ]; then
            print_info "Removing local cache: ./node_modules_cache"
            rm -rf ./node_modules_cache
        fi
        if [ -d "./next_cache" ]; then
            print_info "Removing local cache: ./next_cache"
            rm -rf ./next_cache
        fi
    else
        # Remove named volumes
        if podman volume exists nextra-node-modules 2>/dev/null; then
            print_info "Removing volume: nextra-node-modules"
            podman volume rm nextra-node-modules 2>/dev/null || true
        fi
        if podman volume exists nextra-next-cache 2>/dev/null; then
            print_info "Removing volume: nextra-next-cache"
            podman volume rm nextra-next-cache 2>/dev/null || true
        fi
    fi
    
    # Prune unused images and volumes
    print_info "Pruning unused resources..."
    podman image prune -f 2>/dev/null || true
    podman volume prune -f 2>/dev/null || true
    
    print_success "Cleanup complete"
}

# Function to show status
show_status() {
    check_podman
    
    print_info "Podman Service Status:"
    echo ""
    
    # Show running containers
    echo "Running Containers:"
    podman ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}\t{{.Image}}" | grep -E "(nextra-docs|nextra-nginx|NAMES)" || echo "No Nextra containers running"
    echo ""
    
    # Show networks
    echo "Networks:"
    if podman network exists nextra-network 2>/dev/null; then
        echo "✅ nextra-network exists"
    else
        echo "❌ nextra-network not found"
    fi
    echo ""
    
    # Show volumes/cache
    if [ "$IS_MACOS" = true ]; then
        echo "Local Cache Directories:"
        [ -d "./node_modules_cache" ] && echo "✅ ./node_modules_cache" || echo "❌ ./node_modules_cache"
        [ -d "./next_cache" ] && echo "✅ ./next_cache" || echo "❌ ./next_cache"
    else
        echo "Volumes:"
        podman volume exists nextra-node-modules 2>/dev/null && echo "✅ nextra-node-modules" || echo "❌ nextra-node-modules"
        podman volume exists nextra-next-cache 2>/dev/null && echo "✅ nextra-next-cache" || echo "❌ nextra-next-cache"
    fi
    echo ""
    
    # Show access URLs
    if podman ps --format "{{.Names}}" | grep -q "^nextra-docs$"; then
        echo "Access URLs:"
        echo "📝 Development server: http://localhost:3000"
        if podman ps --format "{{.Names}}" | grep -q "^nextra-nginx$"; then
            echo "🌐 Nginx proxy: http://localhost:8080"
        fi
    else
        echo "ℹ️  No services running. Use './podman-run.sh start' to begin."
    fi
}

# Function to fix macOS permission issues
fix_macos_permissions() {
    if [ "$IS_MACOS" = true ]; then
        print_info "Fixing macOS file permissions..."
        
        # Install dependencies outside container first
        if [ ! -d "node_modules" ]; then
            print_info "Installing dependencies locally first..."
            
            # Check if npm is available locally
            if command -v npm &> /dev/null; then
                npm install
            else
                # Use Podman to install dependencies with proper permissions
                print_info "Using Podman to install dependencies..."
                podman run --rm \
                    -v .:/workspace \
                    -w /workspace \
                    --userns=keep-id \
                    --user $(id -u):$(id -g) \
                    node:18-alpine \
                    sh -c "npm install"
            fi
        fi
        
        # Fix ownership of generated files
        if [ -f "package-lock.json" ]; then
            chmod 644 package-lock.json
        fi
        
        if [ -d "node_modules" ]; then
            find node_modules -type f -exec chmod 644 {} \; 2>/dev/null || true
            find node_modules -type d -exec chmod 755 {} \; 2>/dev/null || true
        fi
        
        print_success "Permissions fixed for macOS"
    fi
}

# Function to show help
show_help() {
    echo "Native Podman Nextra Documentation Runner"
    echo ""
    echo "Usage: $0 [COMMAND]"
    echo ""
    echo "Commands:"
    echo "  dev         Start development server (default)"
    echo "  start       Start in detached/background mode"
    echo "  prod        Start with production setup (nginx proxy)"
    echo "  stop        Stop all services"
    echo "  logs        Show container logs"
    echo "  rebuild     Rebuild and restart services"
    echo "  cleanup     Remove containers, networks, and volumes"
    echo "  status      Show current service status"
    echo "  fix-perms   Fix macOS permission issues"
    echo "  help        Show this help"
    echo ""
    echo "Examples:"
    echo "  $0           # Start development server interactively"
    echo "  $0 start     # Start in background mode"
    echo "  $0 prod      # Start with nginx proxy"
    echo "  $0 logs      # View real-time logs"
    echo "  $0 status    # Check service status"
    echo "  $0 fix-perms # Fix macOS permission issues"
    echo ""
    echo "Native Podman Features:"
    echo "  ✅ No Docker or Docker Compose dependencies"
    echo "  ✅ Pure Podman commands for maximum compatibility"
    echo "  ✅ Automatic OS detection (macOS/Linux)"
    echo "  ✅ SELinux support on Linux"
    echo "  ✅ Optimized volume strategies per platform"
    echo "  ✅ Systemd service generation support"
}

# Main script logic
case "${1:-dev}" in
    "dev"|"develop"|"development")
        start_dev
        ;;
    "start"|"up")
        start_detached
        ;;
    "prod"|"production")
        start_production
        ;;
    "stop"|"down")
        stop_services
        ;;
    "logs"|"log")
        show_logs
        ;;
    "rebuild"|"restart")
        rebuild
        ;;
    "cleanup"|"clean")
        cleanup
        ;;
    "status"|"ps")
        show_status
        ;;
    "fix-perms"|"fix-permissions")
        check_podman
        setup_selinux
        fix_macos_permissions
        ;;
    "help"|"-h"|"--help")
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;
esac
EOF

chmod +x podman-run.sh

# Create .gitignore
cat > .gitignore << 'EOF'
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next/
out/

# Environment variables
.env*.local

# IDE
