#!/usr/bin/env bash
# mbm-nextra-setup-w-podman - create a Nextra documentation site project with a Podman runner
#
# Usage:
#   mbm-nextra-setup-w-podman [options] [PROJECT_DIR]
#
# The same as "mbm-nextra-setup --podman": the project gets podman-run.sh (dev, start, prod,
# logs, status, stop, cleanup) in place of docker-compose.yml. What is written, and with
# which versions, is described by: mbm-nextra-setup --help
#
# Arguments:
#   PROJECT_DIR   the folder to create (default: nextra-docs)
#
# Options:
#   -p PORT, --port PORT   the port the site is served on (default: 3000)
#   -i, --install          run "npm install" in the project once the files are written
#   -n, --dry-run          list the files that would be written; write nothing
#   -y, --yes              write into a folder that is not empty without asking
#   -q, --quiet            do not print what was done
#   -h, --help             show this help
#
# Examples:
#   mbm-nextra-setup-w-podman my-docs
#   mbm-nextra-setup-w-podman --port 8080 "Team Handbook"
#   mbm-nextra-setup-w-podman -n my-docs
#
# Needs: nothing to write the files; podman (https://podman.io) to use the runner.
#        macOS and Linux.

set -u
ME="${0##*/}"
SELF="$0"
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF" | sed "s/mbm-/${ME%nextra-setup-w-podman}/g"; }
die() { echo "$ME: $*" >&2; exit 1; }
# The options are checked by the generator, which reports a wrong one under this command's name.
# shellcheck disable=SC2329  # kept: the standard preamble of every command
bad_usage() { echo "$ME: $* (see: $ME --help)" >&2; exit 2; }

for arg in "$@"; do
  case "$arg" in
    -h|--help) usage; exit 0 ;;
    --) break ;;
  esac
done

# The generator is the file next to this one, wherever the links that start them are.
_s="$SELF"
while [ -L "$_s" ]; do
  _d="$(cd "$(dirname "$_s")" && pwd)"; _s="$(readlink "$_s")"
  case "$_s" in /*) ;; *) _s="$_d/$_s" ;; esac
done
SELF_DIR="$(cd "$(dirname "$_s")" && pwd)"
[ -x "$SELF_DIR/mbm-nextra-setup" ] || die "the generator is missing: $SELF_DIR/mbm-nextra-setup"

NEXTRA_SETUP_ME="$ME" exec "$SELF_DIR/mbm-nextra-setup" --podman "$@"
