#!/usr/bin/env bash
# mbm-find-files-over-100m - list the files over 100 MB (or another size) under a folder, largest first
#
# Usage:
#   mbm-find-files-over-100m [-s SIZE] [-o FILE] [DIR]
#
# Arguments:
#   DIR   the folder to search, with everything below it (default: the current folder)
#
# Options:
#   -s SIZE, --size SIZE     list files larger than SIZE instead of 100M. SIZE is a whole
#                            number followed by K, M, G or T (steps of 1024), as in 500K,
#                            2G or 100mb; a number alone is bytes
#   -o FILE, --output FILE   write the list to FILE instead of showing it
#   -h, --help               show this help
#   --                       end of the options, for a DIR that starts with -
#
# Examples:
#   mbm-find-files-over-100m                       the big files under the current folder
#   mbm-find-files-over-100m ~/Downloads
#   mbm-find-files-over-100m -s 1G ~               files over 1 GB in your home folder
#   mbm-find-files-over-100m -s 500K -o big.txt ~/Documents
#
# Each line is the size, a tab and the path. The size is the length of the file, as
# `ls -l` shows it; a sparse file such as a virtual disk may occupy less on the disk.
# Folders that may not be read are skipped without a message. Symbolic links are not
# followed, except DIR itself.
#
# Exit status: 0 also when no file is that large (a note goes to standard error),
# 1 DIR is not a folder or FILE cannot be written, 2 wrong usage.

set -u
ME="${0##*/}"
SELF="$0"
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF" | sed "s/mbm-/${ME%find-files-over-100m}/g"; }
die() { echo "$ME: $*" >&2; exit 1; }
bad_usage() { echo "$ME: $* (see: $ME --help)" >&2; exit 2; }

SIZE=100M
OUT=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -s|--size) [ $# -ge 2 ] || bad_usage "$1 needs a size"; SIZE="$2"; shift ;;
    -o|--output) [ $# -ge 2 ] || bad_usage "$1 needs a file name"; OUT="$2"; shift ;;
    --) shift; break ;;
    -?*) bad_usage "unknown option: $1" ;;
    *) break ;;
  esac
  shift
done
[ $# -le 1 ] || bad_usage "too many arguments: one folder at a time"
DIR="${1:-.}"

# SIZE in bytes: find -size +Nc means the same on BSD and GNU.
# shellcheck disable=SC2018,SC2019 # plain a-z on purpose: [:lower:] depends on the language
num="$(printf '%s' "$SIZE" | LC_ALL=C tr 'a-z' 'A-Z')"
num="${num%B}"
case "$num" in
  *K) mult=1024 ;;
  *M) mult=1048576 ;;
  *G) mult=1073741824 ;;
  *T) mult=1099511627776 ;;
  *) mult=1 ;;
esac
[ "$mult" = 1 ] || num="${num%?}"
case "$num" in
  ''|*[!0-9]*) bad_usage "not a size: $SIZE (write it like 500K, 100M or 2G)" ;;
esac
digits=6; [ "$mult" = 1 ] && digits=18   # more would not fit in a 64-bit number
[ "${#num}" -le "$digits" ] || bad_usage "the size is too large: $SIZE"
BYTES=$((10#$num * mult))

[ -d "$DIR" ] || die "not a folder: $DIR"
case "$DIR" in -*) DIR="./$DIR" ;; esac
case "$DIR" in *[!/]*/) DIR="${DIR%"${DIR##*[!/]}"}" ;; esac   # Documents/ -> Documents

NL='
'
TAB="$(printf '\t')"
list="$(
  find -H "$DIR" -type f -size +"${BYTES}c" -print0 2>/dev/null |
    while IFS= read -r -d '' f; do
      # The fifth word of `ls -ldn` is the size, on BSD and GNU alike. A line break in a
      # name is shown as ?, so that every file stays on one line.
      read -r _ _ _ _ size _ < <(ls -ldn -- "$f" 2>/dev/null) || continue
      printf '%s\t%s\n' "$size" "${f//$NL/?}"
    done |
    LC_ALL=C sort -t "$TAB" -k1,1nr -k2 |
    LC_ALL=C awk '
      BEGIN { split("K M G T", unit, " ") }
      /^[0-9]/ {
        b = $1; i = 0
        while (b >= 1024 && i < 4) { b /= 1024; i++ }
        size = (i == 0) ? b "B" : sprintf(b < 10 ? "%.1f%s" : "%.0f%s", b, unit[i])
        sub(/^[0-9]*\t/, "")
        print size "\t" $0
      }'
)"

[ -n "$list" ] || echo "$ME: no file under $DIR is larger than $SIZE" >&2
if [ -n "$OUT" ]; then
  { printf '%s' "${list:+$list$NL}" > "$OUT"; } 2>/dev/null || die "cannot write $OUT"
else
  printf '%s' "${list:+$list$NL}"
fi
