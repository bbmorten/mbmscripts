#!/usr/bin/env bash
#
# mbm-copy-zsh-settings — Copy local zsh config to remote macOS host
#
# Copies these if they exist locally:
#   ~/.zshrc
#   ~/.zshenv
#   ~/.zprofile
#   ~/.zlogin
#   ~/.zlogout
#   ~/.p10k.zsh
#   ~/.aliases
#   ~/.zsh_aliases
#   ~/.zsh_functions
#   ~/.config/zsh/  (whole directory if present)
#
# Skips:
#   ~/.zsh_history     (personal)
#   ~/.zcompdump*      (regenerated automatically)
#   ~/.oh-my-zsh/      (installed fresh on remote)
#
# Behavior:
#   - Backs up existing remote dotfiles to ~/.zsh-backup-<timestamp>/
#   - Installs oh-my-zsh on remote if missing
#   - Copies your local custom theme/plugin files from ~/.oh-my-zsh/custom/
#     (so personal themes & plugins come along, but framework code is fresh)
#   - Dry-run mode shows what would happen without changes
#
# Usage:
#   mbm-copy-zsh-settings              # do the copy
#   mbm-copy-zsh-settings --dry-run    # preview only
#   mbm-copy-zsh-settings --help
#

set -euo pipefail

# ─── Configuration ──────────────────────────────────────────────────────────
REMOTE_USER="${MBM_REMOTE_USER:-$USER}"
REMOTE_HOST="${MBM_REMOTE_HOST:-}"
REMOTE="${REMOTE_USER}@${REMOTE_HOST}"

# SSH options (uncomment and adjust if needed)
# SSH_PORT=22
# SSH_KEY="$HOME/.ssh/id_ed25519"
# SSH_OPTS=(-p "$SSH_PORT" -i "$SSH_KEY")
SSH_OPTS=()

LOG_DIR="$HOME/.local/log/copy-zsh-settings"
LOG_FILE="${LOG_DIR}/copy-$(date +%Y-%m-%d_%H-%M-%S).log"

# Files to copy if they exist locally (relative to $HOME)
DOTFILES=(
  ".zshrc"
  ".zshenv"
  ".zprofile"
  ".zlogin"
  ".zlogout"
  ".p10k.zsh"
  ".aliases"
  ".zsh_aliases"
  ".zsh_functions"
)

# Directories to copy (relative to $HOME)
DOTDIRS=(
  ".config/zsh"
)

# Whether to copy oh-my-zsh custom/ (themes + plugins you've added). Default: yes.
COPY_OMZ_CUSTOM=true

DRY_RUN=false

# ─── Helpers ────────────────────────────────────────────────────────────────
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
BLUE=$'\033[0;34m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
NC=$'\033[0m'

log() {
  local level="$1"; shift
  local msg="$*"
  local ts
  ts="$(date '+%Y-%m-%d %H:%M:%S')"
  local color="$NC"
  case "$level" in
    INFO)  color="$BLUE"   ;;
    OK)    color="$GREEN"  ;;
    WARN)  color="$YELLOW" ;;
    ERROR) color="$RED"    ;;
    STAT)  color="$CYAN"   ;;
  esac
  printf '%s[%s] [%s]%s %s\n' "$color" "$ts" "$level" "$NC" "$msg"
  printf '[%s] [%s] %s\n' "$ts" "$level" "$msg" >> "$LOG_FILE"
}

show_help() {
  cat <<EOF
mbm-copy-zsh-settings — Copy zsh config from this Mac to ${REMOTE}

Usage:
  $0              Run the copy (with confirmation prompt)
  $0 --dry-run    Show what would happen, no changes
  $0 --help       Show this help

What it does:
  1. Lists local dotfiles & oh-my-zsh custom/ that will be copied
  2. Backs up existing remote dotfiles to ~/.zsh-backup-<timestamp>/
  3. Copies dotfiles via rsync
  4. Installs oh-my-zsh on remote if missing
  5. Copies your ~/.oh-my-zsh/custom/ (themes, plugins)
  6. Tells you what to review before sourcing on the remote

Logs: ${LOG_DIR}/
EOF
}

# ssh wrapper that uses SSH_OPTS array
rssh() {
  ssh "${SSH_OPTS[@]}" "$REMOTE" "$@"
}

# rsync wrapper
do_rsync() {
  local src="$1"
  local dest="$2"
  local label="$3"
  local extra_args=()

  if [[ "$DRY_RUN" == true ]]; then
    extra_args+=("--dry-run")
  fi

  log INFO "Copying ${label}: ${src} → ${REMOTE}:${dest}"

  if [[ ${#SSH_OPTS[@]} -gt 0 ]]; then
    rsync -avz --human-readable "${extra_args[@]}" \
      -e "ssh ${SSH_OPTS[*]}" \
      "$src" "${REMOTE}:${dest}" 2>&1 | tee -a "$LOG_FILE"
  else
    rsync -avz --human-readable "${extra_args[@]}" \
      "$src" "${REMOTE}:${dest}" 2>&1 | tee -a "$LOG_FILE"
  fi
}

# ─── Phases ─────────────────────────────────────────────────────────────────

check_local() {
  log INFO "Scanning local zsh config files..."

  LOCAL_FILES=()
  for f in "${DOTFILES[@]}"; do
    if [[ -f "$HOME/$f" ]]; then
      LOCAL_FILES+=("$f")
      log INFO "  found: ~/$f"
    fi
  done

  LOCAL_DIRS=()
  for d in "${DOTDIRS[@]}"; do
    if [[ -d "$HOME/$d" ]]; then
      LOCAL_DIRS+=("$d")
      log INFO "  found dir: ~/$d"
    fi
  done

  if [[ ${#LOCAL_FILES[@]} -eq 0 && ${#LOCAL_DIRS[@]} -eq 0 ]]; then
    log ERROR "No local zsh config files found. Nothing to copy."
    exit 1
  fi

  if [[ "$COPY_OMZ_CUSTOM" == true && -d "$HOME/.oh-my-zsh/custom" ]]; then
    OMZ_CUSTOM_FOUND=true
    log INFO "  found: ~/.oh-my-zsh/custom/ (themes/plugins)"
  else
    OMZ_CUSTOM_FOUND=false
  fi
}

check_remote() {
  log INFO "Checking remote ${REMOTE}..."

  if ! rssh "echo connected" >/dev/null 2>&1; then
    log ERROR "Cannot SSH to ${REMOTE}. Check your SSH setup."
    exit 1
  fi
  log OK "SSH connection works"

  REMOTE_OS=$(rssh "uname -s" 2>/dev/null || echo "unknown")
  log INFO "Remote OS: ${REMOTE_OS}"

  if rssh "test -d ~/.oh-my-zsh" 2>/dev/null; then
    REMOTE_HAS_OMZ=true
    log INFO "Remote already has oh-my-zsh"
  else
    REMOTE_HAS_OMZ=false
    log INFO "Remote does NOT have oh-my-zsh — will install"
  fi

  REMOTE_SHELL=$(rssh "dscl . -read /Users/${REMOTE_USER} UserShell 2>/dev/null | awk '{print \$2}'" || echo "")
  log INFO "Remote login shell: ${REMOTE_SHELL:-unknown}"
}

backup_remote() {
  local backup_dir="\$HOME/.zsh-backup-$(date +%Y%m%d-%H%M%S)"

  if [[ "$DRY_RUN" == true ]]; then
    log INFO "[DRY RUN] Would back up existing remote dotfiles to ${backup_dir}"
    return 0
  fi

  log INFO "Backing up existing remote dotfiles to ${backup_dir}..."

  # Build a shell snippet that creates the backup dir and moves anything that exists
  local files_list
  files_list=$(printf '%s ' "${DOTFILES[@]}")

  rssh "mkdir -p ${backup_dir} && for f in ${files_list}; do
    if [ -e \"\$HOME/\$f\" ]; then
      cp -a \"\$HOME/\$f\" \"${backup_dir}/\" 2>/dev/null && echo \"  backed up \$f\"
    fi
  done
  if [ -d \"\$HOME/.config/zsh\" ]; then
    cp -a \"\$HOME/.config/zsh\" \"${backup_dir}/\" && echo \"  backed up .config/zsh\"
  fi
  echo \"Backup at: ${backup_dir}\"" 2>&1 | tee -a "$LOG_FILE"

  log OK "Backup complete"
}

install_omz_remote() {
  if [[ "$REMOTE_HAS_OMZ" == true ]]; then
    log INFO "Skipping oh-my-zsh install (already present on remote)"
    return 0
  fi

  if [[ "$DRY_RUN" == true ]]; then
    log INFO "[DRY RUN] Would install oh-my-zsh on remote"
    return 0
  fi

  log INFO "Installing oh-my-zsh on remote..."
  # KEEP_ZSHRC=yes prevents the installer from overwriting .zshrc
  # (we're about to copy ours anyway, but this avoids a race where the installer
  # writes its template after our copy)
  # RUNZSH=no skips dropping into a new shell
  # CHSH=no skips changing the login shell
  rssh 'sh -c "RUNZSH=no CHSH=no KEEP_ZSHRC=yes \
    \$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"' \
    2>&1 | tee -a "$LOG_FILE"

  log OK "oh-my-zsh installed"
}

copy_files() {
  log INFO "Copying dotfiles..."

  for f in "${LOCAL_FILES[@]}"; do
    do_rsync "$HOME/$f" "$f" "$f"
  done

  for d in "${LOCAL_DIRS[@]}"; do
    # Use trailing slash on source to copy contents
    rssh "mkdir -p ~/$d" 2>/dev/null || true
    do_rsync "$HOME/$d/" "$d/" "$d/"
  done

  if [[ "$OMZ_CUSTOM_FOUND" == true ]]; then
    rssh "mkdir -p ~/.oh-my-zsh/custom" 2>/dev/null || true
    do_rsync "$HOME/.oh-my-zsh/custom/" ".oh-my-zsh/custom/" "oh-my-zsh custom/"
  fi
}

print_followup() {
  cat <<EOF

${BOLD}─── Next steps on the remote ───${NC}

  1. SSH in and review the copied .zshrc:
     ${CYAN}ssh ${REMOTE}${NC}
     ${CYAN}less ~/.zshrc${NC}

  2. Watch for these things that may need adjusting:
     • Homebrew path: should be /opt/homebrew (Apple Silicon) or /usr/local (Intel)
     • Anything referencing local-only paths (e.g. ~/Projects/foo)
     • Plugins listed in ZSH_THEME / plugins=() — confirm they're installed
     • Any API keys / tokens you exported — make sure you want them on the remote

  3. Try loading the config:
     ${CYAN}exec zsh -l${NC}

  4. If something breaks, restore the backup:
     ${CYAN}ls ~/.zsh-backup-*${NC}
     ${CYAN}cp ~/.zsh-backup-<timestamp>/.zshrc ~/.zshrc${NC}

  5. If you want zsh to be the default login shell on the remote:
     ${CYAN}chsh -s /bin/zsh${NC}

EOF
}

confirm() {
  if [[ "$DRY_RUN" == true ]]; then return 0; fi
  echo
  printf '%sThis will overwrite zsh config files on %s.%s\n' "$YELLOW" "$REMOTE" "$NC"
  printf 'Existing files will be backed up first.\n'
  printf 'Proceed? [y/N] '
  read -r answer
  if [[ ! "$answer" =~ ^[Yy]$ ]]; then
    log INFO "Aborted by user"
    exit 0
  fi
}

if [[ -z "$REMOTE_HOST" && "${1:-}" != "-h" && "${1:-}" != "--help" ]]; then
  echo "No remote host is set. Export MBM_REMOTE_HOST (for example in the local.env file of your installation)." >&2
  exit 1
fi

# ─── Main ───────────────────────────────────────────────────────────────────
mkdir -p "$LOG_DIR"

case "${1:-}" in
  -h|--help) show_help; exit 0 ;;
  -n|--dry-run) DRY_RUN=true ;;
  '') : ;;
  *) log ERROR "Unknown option: $1"; show_help; exit 1 ;;
esac

[[ "$DRY_RUN" == true ]] && log INFO "DRY RUN — no changes will be made"

check_local
check_remote

if [[ "$REMOTE_OS" != "Darwin" ]]; then
  log WARN "Remote OS is '${REMOTE_OS}', not Darwin. Some macOS-specific config (Homebrew path, pbcopy, etc.) may not work."
fi

confirm
backup_remote
install_omz_remote
copy_files
print_followup

log OK "Done. Log saved to ${LOG_FILE}"
