#!/usr/bin/env bash
# mbm-copy-zsh-settings - copy your zsh configuration to another machine over ssh
#
# Usage:
#   mbm-copy-zsh-settings [options]
#
# Options:
#   -H, --host HOST   the machine to copy to: a name, an address or USER@HOST
#                     (default: the setting MBM_REMOTE_HOST)
#   -u, --user USER   the account there (default: the setting MBM_REMOTE_USER, else
#                     your user name on this machine)
#   -s, --skip NAME   leave NAME out, for example .zshenv; may be given several times
#       --no-omz      never install oh-my-zsh on the other machine
#   -n, --dry-run     show what would be copied and done; change nothing
#   -y, --yes         do not ask before copying
#   -h, --help        show this help
#
# What is copied, when it exists here, to the same place under the home folder there:
#   .zshrc  .zshenv  .zprofile  .zlogin  .zlogout  .p10k.zsh  .aliases  .zsh_aliases
#   .zsh_functions  .config/zsh  .oh-my-zsh/custom (your own themes and plugins)
# Never copied: .zsh_history, .zcompdump*, oh-my-zsh itself.
#
# The files go to the other machine exactly as they are. If one of them holds
# passwords or API keys (.zshenv often does), they go along: leave it out with --skip.
# A symbolic link is copied as the file it points to.
#
# What happens on the other machine, after you said yes:
#   1. Each of these that is there already is first copied to ~/.zsh-backup-DATE-TIME/.
#   2. If you use oh-my-zsh here and it is missing there, its installer is downloaded
#      from github.com/ohmyzsh/ohmyzsh and run there (needs zsh, curl and git there).
#   3. The files are copied with rsync. In the folders, files that exist only there stay.
#
# Examples:
#   mbm-copy-zsh-settings -H mac-mini.local -n
#   mbm-copy-zsh-settings -H mac-mini.local --skip .zshenv
#   mbm-copy-zsh-settings -H 192.0.2.10 -u admin --no-omz --yes
#
# Needs: ssh and rsync here, rsync on the other machine. macOS and Linux, on both ends.
#        Port, key and other details of the connection belong in ~/.ssh/config.
# Settings: MBM_REMOTE_HOST   the machine to copy to when --host is not given
#           MBM_REMOTE_USER   the account there when --user is not given

set -u
ME="${0##*/}"
SELF="$0"
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF" | sed "s/mbm-/${ME%copy-zsh-settings}/g"; }
die() { echo "$ME: $*" >&2; exit 1; }
bad_usage() { echo "$ME: $* (see: $ME --help)" >&2; exit 2; }
confirm() {   # confirm "Delete 3 files?"   true on y / yes
  local a
  [ "$YES" = 1 ] && return 0
  [ -t 0 ] || die "$1 - not asked: this is not a terminal. Add --yes to go ahead."
  printf '%s [y/N] ' "$1"
  read -r a || a=""
  case "$a" in y|Y|yes|Yes|YES) return 0 ;; *) return 1 ;; esac
}

# Everything this command ever copies, relative to the home folder. No name has a space.
ITEMS=(.zshrc .zshenv .zprofile .zlogin .zlogout .p10k.zsh .aliases .zsh_aliases .zsh_functions .config/zsh .oh-my-zsh/custom)
OMZ_INSTALLER="https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh"

HOST="${MBM_REMOTE_HOST:-}"
RUSER="${MBM_REMOTE_USER:-}"
SKIP=" "
OMZ=1
DRY=0
YES=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -H|--host) [ $# -ge 2 ] || bad_usage "$1 needs a host"; HOST="$2"; shift ;;
    -u|--user) [ $# -ge 2 ] || bad_usage "$1 needs a user name"; RUSER="$2"; shift ;;
    -s|--skip)
      [ $# -ge 2 ] || bad_usage "$1 needs a name"
      n="${2#"$HOME"/}"; n="${n#\~/}"; n="${n%/}"
      case " ${ITEMS[*]} " in
        *" $n "*) SKIP="$SKIP$n " ;;
        *) bad_usage "--skip $2: not one of the names this command copies" ;;
      esac
      shift ;;
    --no-omz) OMZ=0 ;;
    -n|--dry-run) DRY=1 ;;
    -y|--yes) YES=1 ;;
    --) shift; break ;;
    -?*) bad_usage "unknown option: $1" ;;
    *) break ;;
  esac
  shift
done
[ $# -eq 0 ] || bad_usage "unexpected argument: $1"
[ -n "$HOST" ] || bad_usage "no machine to copy to: give --host HOST or set MBM_REMOTE_HOST"
case "$HOST" in
  *@*) REMOTE="$HOST" ;;
  *) REMOTE="${RUSER:-${USER:-$(id -un)}}@$HOST" ;;
esac
case "$REMOTE" in -*|*[[:space:]]*) bad_usage "not a usable user and host: $REMOTE" ;; esac

send=()
left=""
for i in "${ITEMS[@]}"; do
  [ -f "$HOME/$i" ] || [ -d "$HOME/$i" ] || continue
  case "$SKIP" in *" $i "*) left="$left $i" ;; *) send+=("$i") ;; esac
done
[ ${#send[@]} -gt 0 ] || die "nothing to copy: no zsh configuration in $HOME${left:+ besides what --skip leaves out}"
command -v ssh >/dev/null 2>&1 || die "ssh is not installed (Linux: apt install openssh-client)"
command -v rsync >/dev/null 2>&1 || die "rsync is not installed (Linux: apt install rsync)"

# on_remote SCRIPT - run it on the other machine with sh, whatever the login shell there is
on_remote() { printf '%s\n' "$1" | ssh "$REMOTE" sh; }

# One look at the other machine: its system, its login shell, oh-my-zsh, which of the names exist.
# shellcheck disable=SC2016  # the $ in single quotes are for the shell on the other machine
probe="$(on_remote 'echo "os=$(uname -s)"; echo "shell=$SHELL"; [ -d "$HOME/.oh-my-zsh" ] && echo "omz=yes"
for i in '"${ITEMS[*]}"'; do [ -e "$HOME/$i" ] && echo "has=$i"; done; exit 0')" \
  || die "cannot reach $REMOTE with ssh (try: ssh $REMOTE)"
r_os="$(printf '%s\n' "$probe" | sed -n 's/^os=//p')"
[ -n "$r_os" ] || die "$REMOTE did not answer as expected"
r_shell="$(printf '%s\n' "$probe" | sed -n 's/^shell=//p')"
there=" $(printf '%s\n' "$probe" | sed -n 's/^has=//p' | tr '\n' ' ')"
r_omz=no
case "$probe" in *omz=yes*) r_omz=yes ;; esac
need_omz=0
[ "$OMZ" = 1 ] && [ -d "$HOME/.oh-my-zsh" ] && [ "$r_omz" = no ] && need_omz=1

# The plan: files go in one rsync, each folder in its own; what is there already is backed up.
bdir=".zsh-backup-$(date +%Y%m%d-%H%M%S)"
files=()
dirs=""
old=""
echo "To $REMOTE ($r_os):"
for i in "${send[@]}"; do
  if [ "$i" = .oh-my-zsh/custom ] && [ "$r_omz" = no ] && [ "$need_omz" = 0 ]; then
    printf '  %-19s %s\n' "$i/" "not copied: oh-my-zsh is not installed there"
    continue
  fi
  note="new there"
  case "$there" in *" $i "*) note="is there already: kept in ~/$bdir/"; old="$old $i" ;; esac
  if [ -d "$HOME/$i" ]; then
    dirs="$dirs $i"
    i="$i/"
  else
    files+=("$HOME/$i")
  fi
  printf '  %-19s %s\n' "$i" "$note"
done
[ -n "$left" ] && echo "Left out:$left"
[ "$need_omz" = 1 ] && echo "oh-my-zsh is missing there: its installer will be downloaded from $OMZ_INSTALLER and run there (--no-omz: do not)."
[ ${#files[@]} -gt 0 ] || [ -n "$dirs" ] || die "nothing to copy"

RSYNC=(rsync -avzL)
[ "$DRY" = 1 ] && RSYNC+=(--dry-run)
copy() {
  local d
  if [ ${#files[@]} -gt 0 ]; then
    "${RSYNC[@]}" "${files[@]}" "$REMOTE:" || return 1
  fi
  # shellcheck disable=SC2086  # names from ITEMS: no spaces
  for d in $dirs; do
    # In a dry run a folder that is not there yet is left untried: rsync would stop at its missing parent.
    if [ "$DRY" = 1 ]; then case "$there" in *" $d "*) ;; *) continue ;; esac; fi
    "${RSYNC[@]}" "$HOME/$d/" "$REMOTE:$d/" || return 1
  done
}

if [ "$DRY" = 1 ]; then
  echo "Dry run - what rsync would send; nothing is changed on $REMOTE:"
  copy || die "rsync failed"
  exit 0
fi
confirm "Copy these to $REMOTE?" || die "nothing was copied"

# One more connection prepares the other machine: backup, then oh-my-zsh, then the folders.
# shellcheck disable=SC2016  # the $ in single quotes are for the shell on the other machine
prep="b=\"\$HOME/$bdir\"; old='${old# }'; dirs='${dirs# }'"'
for i in $old; do mkdir -p "$b/$(dirname "$i")" && cp -a "$HOME/$i" "$b/$i" || exit 41; done'
[ "$need_omz" = 1 ] && prep="$prep
s=\"\$(curl -fsSL $OMZ_INSTALLER)\" && [ -n \"\$s\" ] && RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c \"\$s\" </dev/null || exit 42"
# shellcheck disable=SC2016
prep="$prep"'
for i in $dirs; do mkdir -p "$HOME/$i" || exit 43; done'
on_remote "$prep"
case $? in
  0) ;;
  41) die "the backup on $REMOTE failed; nothing was changed there" ;;
  42) die "oh-my-zsh could not be installed on $REMOTE (it needs zsh, curl and git there); nothing was copied. Add --no-omz to copy without it" ;;
  *) die "preparing $REMOTE failed; nothing was copied" ;;
esac
copy || die "rsync failed${old:+; what was there before is in ~/$bdir/ on $REMOTE}"

echo
echo "Done. To try it:  ssh $REMOTE  and there  exec zsh -l"
[ -n "$old" ] && echo "To go back, there:  cp -a ~/$bdir/. ~/"
case "$r_shell" in
  */zsh) ;;
  *) echo "The login shell there is ${r_shell:-unknown}, not zsh. To change it, there:  chsh -s \"\$(command -v zsh)\"" ;;
esac
[ "$r_os" = "$(uname -s)" ] || echo "That machine runs $r_os, this one $(uname -s): paths in the files (Homebrew's, for example) may need a change there."
exit 0
