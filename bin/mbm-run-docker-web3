#!/usr/bin/env bash
# mbm-run-docker-web3 - publish a second mkdocs site the way mbm-run-docker-web does, with its own folders
#
# Usage:
#   mbm-run-docker-web3 [options] HOST [PORT]
#
# This is mbm-run-docker-web under another name: it takes the same arguments and options
# (see: mbm-run-docker-web --help) and differs only in where its defaults come from, so that
# a second site has its own project and its own folder on the host:
#   the mkdocs project        $MBM_DOCKER_WEB3_DIR, else ~/git-repos/docker-v3
#   the folder on the remote  $MBM_DOCKER_WEB3_REMOTE_DIR, else the name of the project folder
# Give two sites on one host different ports.
#
# Options:
#   -h, --help   show this help
#
# Examples:
#   mbm-run-docker-web3 lab-vm 5501
#   mbm-run-docker-web3 -n lab-vm 5501
#
# Needs: what mbm-run-docker-web needs. macOS and Linux.
# Settings: MBM_DOCKER_WEB3_DIR          the mkdocs project (default: ~/git-repos/docker-v3)
#           MBM_DOCKER_WEB3_REMOTE_DIR   the folder on HOST (default: the name of the project folder)
#           MBM_DOCKER_WEB_USER          the ssh user on HOST (default: vm)

set -u
ME="${0##*/}"
SELF="$0"
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF" | sed "s/mbm-/${ME%run-docker-web3}/g"; }
die() { echo "$ME: $*" >&2; exit 1; }
bad_usage() { echo "$ME: $* (see: $ME --help)" >&2; exit 2; }

for a in "$@"; do
  case "$a" in
    -h|--help) usage; exit 0 ;;
    --) break ;;
  esac
done
[ $# -gt 0 ] || bad_usage "HOST is missing"

# The real folder of this file, through the symlink it was called by.
_s="$SELF"
while [ -L "$_s" ]; do
  _d="$(cd "$(dirname "$_s")" && pwd)"; _s="$(readlink "$_s")"
  case "$_s" in /*) ;; *) _s="$_d/$_s" ;; esac
done
SELF_DIR="$(cd "$(dirname "$_s")" && pwd)"
[ -x "$SELF_DIR/mbm-run-docker-web" ] || die "mbm-run-docker-web is missing from $SELF_DIR"

MBM_DOCKER_WEB_DIR="${MBM_DOCKER_WEB3_DIR:-$HOME/git-repos/docker-v3}"
MBM_DOCKER_WEB_REMOTE_DIR="${MBM_DOCKER_WEB3_REMOTE_DIR:-}"
export MBM_DOCKER_WEB_DIR MBM_DOCKER_WEB_REMOTE_DIR
exec "$SELF_DIR/mbm-run-docker-web" "$@"
