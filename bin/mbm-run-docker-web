#!/usr/bin/env zsh

cd ~/git-repos/docker
source ~/git-repos/docker/.venv/bin/activate
mkdocs build
rsync -avz ~/git-repos/docker/site/ vm@$1:~/docker/

# Prompt user to enter a port number
port=$2 || 5500

# Start Nginx container with the specified port number
ssh vm@$1 "docker run --rm -d -p $port:80 -v /home/vm/docker/:/usr/share/nginx/html:ro nginx"

