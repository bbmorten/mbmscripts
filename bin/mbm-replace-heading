#!/bin/bash

log_file="./logfile.txt"
directory_path=NaN

# Ask for the directory if not provided as an argument
if [ -z "$1" ]; then
    read -p "Enter the directory path: " directory_path
    echo "directory_path: $directory_path"
fi

if [ -z "$directory_path" ]; then
    directory_path="${MBM_REPLACE_HEADING_DIR:-$PWD}"
else
    directory_path="$1"
fi

# Check if the provided path is a valid directory
if [ ! -d "$directory_path" ]; then
    echo "Invalid directory path."
    exit 1
fi

# Use find to locate .txt files in the directory
find "$directory_path" -type f -name "*.md" | while read -r file_path; do
    # Get the first line of the file
    first_line=$(head -n 1 "$file_path")

    # Check if the first line matches the pattern '# DDMMYYYY'
    if [[ $first_line =~ ^#([[:space:]])?([0-9]{2})([0-9]{2})([0-9]{4})(.*) ]]; then
        day="${BASH_REMATCH[2]}"
        month="${BASH_REMATCH[3]}"
        year="${BASH_REMATCH[4]}"
        rest="${BASH_REMATCH[5]}"

        # Construct the new line '# YYYYMMDD'
        new_first_line="# ${year}${month}${day}${rest}"

        # Replace the first line with the new line
        echo $new_first_line
        echo $file_path
        # sed -i '1s/.*/$new_first_line/' "$file_path" #> /dev/null 2>&1
        sed -i '' -e "1s/.*/$new_first_line/" "$file_path"

        echo "Date format replaced in $file_path"
    else
        echo "Date format not found in the first line of $file_path"
    fi
done
