#!/usr/bin/env bash
# mbm-replace-heading - rewrite a first-line heading "# DDMMYYYY" as "# YYYYMMDD" in Markdown files
#
# Usage:
#   mbm-replace-heading [-n] [DIR]
#
# Arguments:
#   DIR   the folder whose .md files are checked, with the folders below it
#         (default: the folder named in MBM_REPLACE_HEADING_DIR)
#
# Options:
#   -n, --dry-run   show the headings that would change; change nothing
#   -h, --help      show this help
#
# Examples:
#   mbm-replace-heading ~/Notes/daily
#   mbm-replace-heading -n ~/Notes/daily
#
# Only line 1 of a file is looked at, and only when it is "#", at most one space or tab,
# and eight digits that are a real day, month and year: "# 25122023 Standup" becomes
# "# 20231225 Standup". The year must be 1900-2099, so a heading that is YYYYMMDD already
# is left alone and a second run changes nothing. The rest of the line and of the file
# stay as they are, and so do the file's permissions.
# The matching DDMMYYYY.md file names are converted by mbm-change-filename.
#
# Settings: MBM_REPLACE_HEADING_DIR   the folder to use when DIR is not given (default:
#           none - without DIR and without this setting nothing is done)
#
# Exit status: 0 done, 1 DIR is not a folder or a file could not be rewritten, 2 wrong usage.

set -u
ME="${0##*/}"
SELF="$0"
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF" | sed "s/mbm-/${ME%replace-heading}/g"; }
die() { echo "$ME: $*" >&2; exit 1; }
bad_usage() { echo "$ME: $* (see: $ME --help)" >&2; exit 2; }

DRY=0
ARGS=()   # what is not an option; options may stand anywhere before a "--"
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -n|--dry-run) DRY=1 ;;
    --) shift; while [ $# -gt 0 ]; do ARGS[${#ARGS[@]}]="$1"; shift; done; break ;;
    -?*) bad_usage "unknown option: $1" ;;
    *) ARGS[${#ARGS[@]}]="$1" ;;
  esac
  shift
done
set -- ${ARGS[@]+"${ARGS[@]}"}
[ $# -le 1 ] || bad_usage "expected one folder, got $# arguments"
dir="${1:-${MBM_REPLACE_HEADING_DIR:-}}"
[ -n "$dir" ] || bad_usage "no folder given and MBM_REPLACE_HEADING_DIR is not set"
[ -d "$dir" ] || die "not a folder: $dir"
case "$dir" in -*) dir="./$dir" ;; esac   # find would read it as an option

# iso DDMMYYYY - print YYYYMMDD; false when the eight digits are not a date in 1900-2099
iso() {
  local d m y last
  d=$((10#${1:0:2})) m=$((10#${1:2:2})) y=$((10#${1:4:4}))
  [ "$y" -ge 1900 ] && [ "$y" -le 2099 ] && [ "$m" -ge 1 ] && [ "$m" -le 12 ] || return 1
  case "$m" in
    4|6|9|11) last=30 ;;
    2) last=28
       if [ $((y % 4)) -eq 0 ] && { [ $((y % 100)) -ne 0 ] || [ $((y % 400)) -eq 0 ]; }; then last=29; fi ;;
    *) last=31 ;;
  esac
  [ "$d" -ge 1 ] && [ "$d" -le "$last" ] || return 1
  printf '%s%s%s\n' "${1:4:4}" "${1:2:2}" "${1:0:2}"
}

tmp=""
if [ "$DRY" = 0 ]; then
  tmp="$(mktemp)" || die "cannot make a temporary file"
  trap 'rm -f "$tmp"' EXIT
fi

# "#", at most one space or tab, eight digits, then the end or something that is not a digit
heading='^#[[:blank:]]?([0-9]{8})([^0-9].*)?$'
changed=0 failed=0
while IFS= read -r -d '' f; do
  # A first line without a line end is still read; it is written back without one.
  end=$'\n'
  first=""
  IFS= read -r first < "$f" || end=""
  [[ $first =~ $heading ]] || continue
  rest="${BASH_REMATCH[2]:-}"
  new="$(iso "${BASH_REMATCH[1]}")" || continue
  new="# $new$rest"
  if [ "$DRY" = 0 ]; then
    # Through a temporary file and back with cat: the file keeps its permissions and owner.
    if [ -w "$f" ] && { printf '%s' "$new$end"; tail -n +2 < "$f"; } > "$tmp" && cat "$tmp" > "$f"; then
      :
    else
      echo "$ME: could not rewrite $f" >&2
      failed=$((failed + 1))
      continue
    fi
  fi
  printf '%s: %s -> %s\n' "$f" "${first%$'\r'}" "${new%$'\r'}"
  changed=$((changed + 1))
done < <(find "${dir%/}/" -type f -name '*.md' -print0)

if [ "$DRY" = 1 ]; then what="Headings that would be rewritten"; else what="Headings rewritten"; fi
echo "$what in $dir: $changed."
[ "$failed" = 0 ] || die "files that could not be rewritten: $failed"
