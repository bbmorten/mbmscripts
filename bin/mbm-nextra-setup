#!/bin/bash

# Nextra Project Setup Script
# Usage: mbm-nextra-setup [project-name]

set -e

# Default project name
PROJECT_NAME=${1:-"nextra-docs"}

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if project directory already exists
if [ -d "$PROJECT_NAME" ]; then
    print_error "Directory '$PROJECT_NAME' already exists!"
    read -p "Do you want to continue and overwrite? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        print_warning "Aborting setup."
        exit 1
    fi
    rm -rf "$PROJECT_NAME"
fi

print_status "Creating Nextra project: $PROJECT_NAME"

# Create project directory
mkdir -p "$PROJECT_NAME"
cd "$PROJECT_NAME"

# Create directory structure
print_status "Creating project structure..."
mkdir -p pages
mkdir -p pages/docs
mkdir -p pages/api
mkdir -p public
mkdir -p components

# Create package.json
print_status "Creating package.json..."
cat > package.json << 'EOF'
{
  "name": "nextra-docs",
  "version": "1.0.0",
  "description": "Documentation site built with Nextra",
  "main": "index.js",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "export": "next export"
  },
  "dependencies": {
    "next": "^14.0.0",
    "nextra": "^2.13.0",
    "nextra-theme-docs": "^2.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "typescript": "^5.0.0"
  }
}
EOF

# Create next.config.js
print_status "Creating Next.js configuration..."
cat > next.config.js << 'EOF'
const withNextra = require('nextra')({
  theme: 'nextra-theme-docs',
  themeConfig: './theme.config.tsx',
})

module.exports = withNextra({
  output: 'standalone',
  experimental: {
    outputFileTracingRoot: __dirname,
  },
})
EOF

# Create theme.config.tsx
print_status "Creating theme configuration..."
cat > theme.config.tsx << 'EOF'
import React from 'react'
import { DocsThemeConfig } from 'nextra-theme-docs'

const config: DocsThemeConfig = {
  logo: <span>My Documentation</span>,
  project: {
    link: 'https://github.com/your-username/your-repo',
  },
  docsRepositoryBase: 'https://github.com/your-username/your-repo',
  footer: {
    text: 'Documentation built with Nextra',
  },
  search: {
    placeholder: 'Search documentation...'
  },
  sidebar: {
    titleComponent({ title, type }) {
      if (type === 'separator') {
        return <span className="cursor-default">{title}</span>
      }
      return <>{title}</>
    },
    defaultMenuCollapseLevel: 1,
    toggleButton: true
  },
  toc: {
    backToTop: true
  }
}

export default config
EOF

# Create main pages
print_status "Creating documentation pages..."

# Main index page
cat > pages/index.mdx << 'EOF'
# Welcome to My Documentation

This is the home page of your documentation site built with Nextra.

## Getting Started

Navigate through the documentation using the sidebar, or explore these sections:

- [Documentation](/docs) - Main documentation content
- [API Reference](/api) - API documentation

## Features

- **Fast**: Built with Next.js for optimal performance
- **Modern**: MDX support for interactive content
- **Searchable**: Built-in search functionality
- **Responsive**: Works great on mobile and desktop
- **Customizable**: Easy to theme and extend

## Quick Links

- [Nextra Documentation](https://nextra.site)
- [Next.js Documentation](https://nextjs.org/docs)
EOF

# Documentation index
cat > pages/docs/index.mdx << 'EOF'
# Documentation

Welcome to the documentation section. Here you'll find detailed guides and tutorials.

## Table of Contents

- [Getting Started](./getting-started)
- [Advanced Usage](./advanced-usage)
- [Configuration](./configuration)

## Overview

This documentation covers all aspects of using this project. Each section is designed to help you understand and implement the features effectively.
EOF

# Getting started page
cat > pages/docs/getting-started.mdx << 'EOF'
# Getting Started

This guide will help you get started quickly.

## Installation

First, clone the repository:

```bash
git clone https://github.com/your-username/your-repo.git
cd your-repo
```

## Configuration

Create a configuration file:

```json
{
  "name": "my-project",
  "version": "1.0.0"
}
```

## Usage

Run the development server:

```bash
npm run dev
```

Your site will be available at `http://localhost:3000`.

## Next Steps

- [Advanced Usage](./advanced-usage)
- [Configuration](./configuration)
EOF

# Advanced usage page
cat > pages/docs/advanced-usage.mdx << 'EOF'
# Advanced Usage

Learn about advanced features and configurations.

## Custom Components

You can create custom React components and use them in your MDX files:

```jsx
import { Callout } from 'nextra-theme-docs'

<Callout emoji="💡">
  This is a helpful tip!
</Callout>
```

## Code Highlighting

Nextra supports syntax highlighting for many languages:

```python
def hello_world():
    print("Hello, World!")
    return True
```

```javascript
function greet(name) {
    console.log(`Hello, ${name}!`);
    return `Hello, ${name}!`;
}
```

## Tables

| Feature | Supported |
|---------|-----------|
| MDX | ✅ |
| Search | ✅ |
| Dark Mode | ✅ |
| Mobile | ✅ |
EOF

# Configuration page
cat > pages/docs/configuration.mdx << 'EOF'
# Configuration

Learn how to configure your documentation site.

## Theme Configuration

Edit `theme.config.tsx` to customize:

- Site logo and branding
- Navigation links
- Footer content
- Search settings

## Next.js Configuration

The `next.config.js` file controls:

- Build settings
- Output configuration
- Plugin settings

## Environment Variables

You can use environment variables for configuration:

```bash
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id
```

## Deployment

### Docker

Use the provided Docker configuration:

```bash
docker-compose up -d
```

### Vercel

Deploy to Vercel with zero configuration:

```bash
vercel --prod
```
EOF

# API documentation
cat > pages/api/index.mdx << 'EOF'
# API Reference

This section contains API documentation.

## Authentication

All API requests require authentication:

```bash
curl -H "Authorization: Bearer YOUR_TOKEN" \
     https://api.example.com/endpoint
```

## Endpoints

### GET /users

Retrieve a list of users.

**Response:**

```json
{
  "users": [
    {
      "id": 1,
      "name": "John Doe",
      "email": "john@example.com"
    }
  ]
}
```

### POST /users

Create a new user.

**Request:**

```json
{
  "name": "Jane Doe",
  "email": "jane@example.com"
}
```
EOF

# Create _meta.json files for navigation
cat > pages/_meta.json << 'EOF'
{
  "index": "Home",
  "docs": "Documentation",
  "api": "API Reference"
}
EOF

cat > pages/docs/_meta.json << 'EOF'
{
  "index": "Overview",
  "getting-started": "Getting Started",
  "advanced-usage": "Advanced Usage",
  "configuration": "Configuration"
}
EOF

# Create Docker Compose file
print_status "Creating docker-compose.yml..."
cat > docker-compose.yml << 'EOF'
version: '3.8'

services:
  nextra:
    image: node:18-alpine
    container_name: nextra-docs
    ports:
      - "3000:3000"
    volumes:
      - .:/app
      - /app/node_modules
      - /app/.next
    working_dir: /app
    command: sh -c "npm install && npm run dev"
    environment:
      - NODE_ENV=development
      - NEXT_TELEMETRY_DISABLED=1
    restart: unless-stopped
    networks:
      - nextra-network

  # Optional: Add nginx for production-like serving
  nginx:
    image: nginx:alpine
    container_name: nextra-nginx
    ports:
      - "8080:80"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf
    depends_on:
      - nextra
    networks:
      - nextra-network
    profiles:
      - production

networks:
  nextra-network:
    driver: bridge
EOF

# Create Dockerfile for production
print_status "Creating Dockerfile..."
cat > Dockerfile << 'EOF'
FROM node:18-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Install dependencies
COPY package.json package-lock.json* ./
RUN npm ci

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npm run build

# Production image, copy all the files and run next
FROM base AS runner
WORKDIR /app

ENV NODE_ENV production
ENV NEXT_TELEMETRY_DISABLED 1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public

# Set the correct permission for prerender cache
RUN mkdir .next
RUN chown nextjs:nodejs .next

# Automatically leverage output traces to reduce image size
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT 3000
ENV HOSTNAME "0.0.0.0"

CMD ["node", "server.js"]
EOF

# Create nginx configuration
print_status "Creating nginx configuration..."
cat > nginx.conf << 'EOF'
server {
    listen 80;
    server_name localhost;

    location / {
        proxy_pass http://nextra:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
EOF

# Create .dockerignore
cat > .dockerignore << 'EOF'
node_modules
.next
.git
.gitignore
README.md
.env*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
EOF

# Create .gitignore
cat > .gitignore << 'EOF'
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next/
out/

# Environment variables
.env*.local

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
EOF

# Create README
print_status "Creating README.md..."
cat > README.md << EOF
# $PROJECT_NAME

Documentation site built with Nextra and Next.js.

## Quick Start

### Development

Start the development server:

\`\`\`bash
docker-compose up
\`\`\`

The site will be available at \`http://localhost:3000\`.

### Production

Build and run the production version:

\`\`\`bash
docker-compose --profile production up --build
\`\`\`

Access via nginx at \`http://localhost:8080\`.

## Project Structure

\`\`\`
$PROJECT_NAME/
├── pages/           # Documentation pages (MDX files)
│   ├── docs/        # Main documentation
│   ├── api/         # API documentation
│   └── index.mdx    # Home page
├── components/      # Custom React components
├── public/          # Static assets
├── theme.config.tsx # Nextra theme configuration
├── next.config.js   # Next.js configuration
└── docker-compose.yml
\`\`\`

## Writing Documentation

- Create new MDX files in the \`pages/\` directory
- Use \`_meta.json\` files to control navigation
- Add custom components in the \`components/\` directory

## Deployment

### Docker
\`\`\`bash
docker build -t $PROJECT_NAME .
docker run -p 3000:3000 $PROJECT_NAME
\`\`\`

### Vercel
\`\`\`bash
npx vercel --prod
\`\`\`

## Resources

- [Nextra Documentation](https://nextra.site)
- [Next.js Documentation](https://nextjs.org/docs)
- [MDX Documentation](https://mdxjs.com)
EOF

# Make the script executable if it's the main script
if [ "$0" = "${BASH_SOURCE[0]}" ]; then
    chmod +x "$0" 2>/dev/null || true
fi

print_success "Nextra project '$PROJECT_NAME' created successfully!"
print_status "Next steps:"
echo "  1. cd $PROJECT_NAME"
echo "  2. docker-compose up"
echo "  3. Open http://localhost:3000 in your browser"
echo ""
print_status "To start editing:"
echo "  - Add new pages in the 'pages/' directory"
echo "  - Edit theme.config.tsx for site configuration"
echo "  - Add custom components in the 'components/' directory"