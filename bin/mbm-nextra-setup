#!/usr/bin/env bash
# mbm-nextra-setup - create a documentation site project (Nextra 4 on Next.js) in a new folder
#
# Usage:
#   mbm-nextra-setup [options] [PROJECT_DIR]
#
# Arguments:
#   PROJECT_DIR   the folder to create (default: nextra-docs). The project is named after
#                 its last part, in lower case with dashes: "Team Handbook" gives team-handbook.
#
# Options:
#   -p PORT, --port PORT   the port the site is served on (default: 3000)
#       --podman           write podman-run.sh, a runner for Podman, instead of docker-compose.yml
#   -i, --install          run "npm install" in the project once the files are written
#   -n, --dry-run          list the files that would be written; write nothing
#   -y, --yes              write into a folder that is not empty without asking
#   -q, --quiet            do not print what was done
#   -h, --help             show this help
#
# What is written: package.json, next.config.mjs, mdx-components.js, app/ (the layout and the
# route that renders the pages), content/ (six sample .mdx pages and their _meta.js menus),
# public/, Dockerfile, .dockerignore, .gitignore, README.md, and docker-compose.yml or
# podman-run.sh. The versions are fixed to the ones this generator was built and tried with:
# nextra 4.6.1, nextra-theme-docs 4.6.1, next 16.4.6, react 19.3.1, pagefind 1.6.0, and
# zod 4.1.12 (held back: nextra 4.6.1 does not build with zod 4.6.7).
#
# A folder that already has files in it is written into only after you confirm (or with
# --yes). Files of the same name are replaced; nothing else in it is changed or deleted.
#
# Examples:
#   mbm-nextra-setup my-docs
#   mbm-nextra-setup --install my-docs
#   mbm-nextra-setup --podman --port 8080 "Team Handbook"
#   mbm-nextra-setup -n my-docs
#
# Needs: nothing to write the files. The project needs Node.js 20.9 or newer with npm
#        (https://nodejs.org, or: brew install node); --install needs npm. macOS and Linux.
# Exit status: 0 done, 1 it could not be done or you did not confirm, 2 called wrongly.

set -u
ME="${0##*/}"
SELF="$0"
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF" | sed "s/mbm-/${ME%nextra-setup}/g"; }
die() { echo "$ME: $*" >&2; exit 1; }
bad_usage() { echo "$ME: $* (see: $ME --help)" >&2; exit 2; }

NODE_IMAGE=node:24-slim
PORT=3000
PODMAN=0
INSTALL=0
DRY=0
YES=0
QUIET=0
DIR=""
HAVE_DIR=0

set_dir() {
  [ "$HAVE_DIR" = 0 ] || bad_usage "more than one PROJECT_DIR: '$DIR' and '$1'"
  [ -n "$1" ] || bad_usage "PROJECT_DIR is empty"
  DIR="$1"
  HAVE_DIR=1
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -p|--port) [ $# -ge 2 ] || bad_usage "$1 needs a port number"; PORT="$2"; shift ;;
    --port=*) PORT="${1#--port=}" ;;
    --podman) PODMAN=1 ;;
    -i|--install) INSTALL=1 ;;
    -n|--dry-run) DRY=1 ;;
    -y|--yes) YES=1 ;;
    -q|--quiet) QUIET=1 ;;
    --) shift; while [ $# -gt 0 ]; do set_dir "$1"; shift; done; break ;;
    -?*) bad_usage "unknown option $1" ;;
    *) set_dir "$1" ;;
  esac
  shift
done
[ "$HAVE_DIR" = 1 ] || DIR=nextra-docs

case "$PORT" in ''|*[!0-9]*) bad_usage "the port must be a number from 1 to 65535, not '$PORT'" ;; esac
{ [ "${#PORT}" -le 5 ] && [ "$PORT" -ge 1 ] && [ "$PORT" -le 65535 ]; } ||
  bad_usage "the port must be a number from 1 to 65535, not '$PORT'"
PORT=$((10#$PORT))

case "$DIR" in /*|./*|../*) ;; *) DIR="./$DIR" ;; esac   # a name like -docs is not an option
[ ! -e "$DIR" ] || [ -d "$DIR" ] || die "${DIR#./} exists and is not a folder"

# The project name: the last part of the folder, as a slug (also the container name).
base="${DIR%/}"
base="${base##*/}"
case "$base" in ''|.|..) base="$(cd "$DIR" 2>/dev/null && pwd -P)"; base="${base##*/}" ;; esac
# shellcheck disable=SC2018,SC2019  # on purpose: [:upper:] turns I into a dotless i in a Turkish locale
NAME="$(printf '%s' "$base" | LC_ALL=C tr 'A-Z' 'a-z' | LC_ALL=C sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//')"
[ -n "$NAME" ] || NAME=nextra-docs

if [ "$INSTALL" = 1 ] && [ "$DRY" = 0 ]; then
  command -v npm >/dev/null 2>&1 ||
    die "npm is not installed (get Node.js from https://nodejs.org, or: brew install node)"
fi

confirm() {   # confirm "Delete 3 files?"   true on y / yes
  local a
  [ "$YES" = 1 ] && return 0
  [ -t 0 ] || die "$1 - not asked: this is not a terminal. Add --yes to go ahead."
  printf '%s [y/N] ' "$1"
  read -r a || a=""
  case "$a" in y|Y|yes|Yes|YES) return 0 ;; *) return 1 ;; esac
}

# put FILE - one file of the project; its text comes on standard input, where @NAME@,
# @PORT@ and @NODE@ are filled in. With MODE=list it only prints the file's name.
put() {
  if [ "$MODE" = list ]; then
    cat > /dev/null
    printf '%s\n' "$1"
    return
  fi
  mkdir -p -- "$(dirname "$DIR/$1")" || die "cannot create the folder for $1"
  sed "s/@NAME@/$NAME/g; s/@PORT@/$PORT/g; s|@NODE@|$NODE_IMAGE|g" > "$DIR/$1" ||
    die "cannot write ${DIR#./}/$1"
}

generate() {
  put package.json <<'EOF_FILE'
{
  "name": "@NAME@",
  "version": "1.0.0",
  "private": true,
  "description": "Documentation site built with Nextra",
  "scripts": {
    "dev": "next dev -p @PORT@",
    "build": "next build",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "start": "next start -p @PORT@"
  },
  "dependencies": {
    "next": "16.4.6",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "pagefind": "1.6.0"
  },
  "overrides": {
    "zod": "4.1.12"
  }
}
EOF_FILE

  put next.config.mjs <<'EOF_FILE'
import nextra from 'nextra'

const withNextra = nextra({})

export default withNextra({
  // The Dockerfile builds with BUILD_STANDALONE=1: a self-contained server in .next/standalone.
  output: process.env.BUILD_STANDALONE ? 'standalone' : undefined,
  outputFileTracingRoot: import.meta.dirname,
  turbopack: { root: import.meta.dirname }
})
EOF_FILE

  put mdx-components.js <<'EOF_FILE'
import { useMDXComponents as getThemeComponents } from 'nextra-theme-docs'

const themeComponents = getThemeComponents()

export function useMDXComponents(components) {
  return { ...themeComponents, ...components }
}
EOF_FILE

  put app/layout.jsx <<'EOF_FILE'
import { Footer, Layout, Navbar } from 'nextra-theme-docs'
import { Head } from 'nextra/components'
import { getPageMap } from 'nextra/page-map'
import 'nextra-theme-docs/style.css'

// The site's title, logo, links and footer are set here.
export const metadata = {
  title: { default: 'My Documentation', template: '%s - My Documentation' },
  description: 'Documentation site built with Nextra'
}

const navbar = <Navbar logo={<b>My Documentation</b>} />
const footer = <Footer>Documentation built with Nextra</Footer>

export default async function RootLayout({ children }) {
  return (
    <html lang="en" dir="ltr" suppressHydrationWarning>
      <Head />
      <body>
        <Layout
          navbar={navbar}
          footer={footer}
          pageMap={await getPageMap()}
          docsRepositoryBase="https://github.com/your-username/your-repo/tree/main"
          sidebar={{ defaultMenuCollapseLevel: 1 }}
        >
          {children}
        </Layout>
      </body>
    </html>
  )
}
EOF_FILE

  put 'app/[[...mdxPath]]/page.jsx' <<'EOF_FILE'
// Renders every page in content/: content/docs/index.mdx is served as /docs.
import { generateStaticParamsFor, importPage } from 'nextra/pages'
import { useMDXComponents as getMDXComponents } from '../../mdx-components'

export const generateStaticParams = generateStaticParamsFor('mdxPath')

export async function generateMetadata(props) {
  const params = await props.params
  const { metadata } = await importPage(params.mdxPath)
  return metadata
}

const Wrapper = getMDXComponents().wrapper

export default async function Page(props) {
  const params = await props.params
  const { default: MDXContent, toc, metadata, sourceCode } = await importPage(params.mdxPath)
  return (
    <Wrapper toc={toc} metadata={metadata} sourceCode={sourceCode}>
      <MDXContent {...props} params={params} />
    </Wrapper>
  )
}
EOF_FILE

  put content/_meta.js <<'EOF_FILE'
export default {
  index: 'Home',
  docs: 'Documentation',
  api: 'API Reference'
}
EOF_FILE

  put content/index.mdx <<'EOF_FILE'
# Welcome to My Documentation

This is the home page of your documentation site, built with [Nextra](https://nextra.site).

## Getting started

Use the sidebar, or go straight to a section:

- [Documentation](/docs) - guides
- [API Reference](/api) - a sample reference page

## What you get

- Pages written in Markdown (MDX), one file per page in `content/`
- Full-text search, indexed by `npm run build`
- Dark mode, a table of contents on every page, and a layout that works on a phone
EOF_FILE

  put content/docs/_meta.js <<'EOF_FILE'
export default {
  index: 'Overview',
  'getting-started': 'Getting Started',
  'advanced-usage': 'Advanced Usage',
  configuration: 'Configuration'
}
EOF_FILE

  put content/docs/index.mdx <<'EOF_FILE'
# Documentation

Guides for this project. Replace these sample pages with your own.

- [Getting Started](/docs/getting-started)
- [Advanced Usage](/docs/advanced-usage)
- [Configuration](/docs/configuration)
EOF_FILE

  put content/docs/getting-started.mdx <<'EOF_FILE'
# Getting Started

## Run the site

```bash
npm install
npm run dev
```

The site is at `http://localhost:@PORT@` and reloads when you save a file.

## Add a page

1. Create `content/docs/my-page.mdx` and start it with a `# Title`.
2. Add `'my-page': 'My Page'` to `content/docs/_meta.js` to place it in the sidebar.

A folder becomes a section: `content/guides/index.mdx` is served as `/guides`.

## Next steps

- [Advanced Usage](/docs/advanced-usage)
- [Configuration](/docs/configuration)
EOF_FILE

  put content/docs/advanced-usage.mdx <<'EOF_FILE'
import { Callout } from 'nextra/components'

# Advanced Usage

## Components

An `.mdx` page can import and use React components:

<Callout type="info">
  This box is the `Callout` component of Nextra, imported at the top of this file.
</Callout>

## Code highlighting

```python
def hello_world():
    print("Hello, World!")
    return True
```

```javascript
function greet(name) {
  return `Hello, ${name}!`
}
```

## Tables

| Feature   | Supported |
| --------- | --------- |
| MDX       | yes       |
| Search    | yes       |
| Dark mode | yes       |
EOF_FILE

  put content/docs/configuration.mdx <<'EOF_FILE'
# Configuration

| File                     | What it controls                                    |
| ------------------------ | --------------------------------------------------- |
| `app/layout.jsx`         | the site title, the logo, the footer, the repository link |
| `content/**/_meta.js`    | the order and the titles of the pages in the sidebar |
| `next.config.mjs`        | the build (Next.js and Nextra options)              |
| `package.json`           | the port (`-p @PORT@`) and the versions             |

## Environment variables

Next.js reads `.env.local`. A variable whose name starts with `NEXT_PUBLIC_` is also
available in the browser:

```bash
NEXT_PUBLIC_SITE_URL=https://docs.example.com
```

## Deployment

The `Dockerfile` builds a self-contained server (`.next/standalone`) into a container
image. `README.md` has the commands.
EOF_FILE

  put content/api/index.mdx <<'EOF_FILE'
# API Reference

A sample reference page.

## Authentication

Every request carries a token:

```bash
curl -H "Authorization: Bearer YOUR_TOKEN" https://api.example.com/users
```

## GET /users

Returns the list of users.

```json
{
  "users": [{ "id": 1, "name": "John Doe", "email": "john@example.com" }]
}
```

## POST /users

Creates a user.

```json
{ "name": "Jane Doe", "email": "jane@example.com" }
```
EOF_FILE

  # Keeps public/ in git: the Dockerfile copies that folder.
  put public/.gitkeep < /dev/null

  put Dockerfile <<'EOF_FILE'
# The production image: docker build -t @NAME@ .   (or: podman build -t @NAME@ .)
FROM @NODE@ AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1 BUILD_STANDALONE=1
RUN npm run build

FROM @NODE@
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=@PORT@ HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app/public ./public
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE @PORT@
CMD ["node", "server.js"]
EOF_FILE

  put .dockerignore <<'EOF_FILE'
node_modules
.next
.git
public/_pagefind
.env*.local
npm-debug.log*
EOF_FILE

  put .gitignore <<'EOF_FILE'
node_modules/
.next/
out/
public/_pagefind/
.env*.local
*.log
.DS_Store
EOF_FILE

  if [ "$PODMAN" = 1 ]; then
    put podman-run.sh <<'EOF_FILE'
#!/usr/bin/env bash
# podman-run.sh - run this documentation site in a Podman container
#
# Usage:
#   ./podman-run.sh [COMMAND]
#
# Commands:
#   dev       run the development server in the foreground (the default); Ctrl-C stops it
#   start     run the development server in the background
#   prod      build the production image from the Dockerfile and run it in the background
#   logs      follow the output of the container
#   status    show the container
#   stop      stop and remove the container
#   cleanup   stop, then remove the dependencies volume and the production image
#   help      show this help
#
# The site is served at http://localhost:@PORT@. To use another port of this machine, set
# PORT:   PORT=4000 ./podman-run.sh start
# dev, start and prod use one container, @NAME@-site: starting one replaces the other.

set -eu
cd "$(dirname "$0")"
NAME=@NAME@-site
VOLUME="$NAME-modules"
PORT="${PORT:-@PORT@}"
CMD="${1:-dev}"

case "$CMD" in
  help|-h|--help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "${0##*/}"; exit 0 ;;
  dev|start|prod|logs|status|stop|cleanup) ;;
  *) echo "podman-run.sh: unknown command $CMD (see: ./podman-run.sh help)" >&2; exit 2 ;;
esac
command -v podman >/dev/null 2>&1 ||
  { echo "podman-run.sh: podman is not installed (https://podman.io/docs/installation)" >&2; exit 1; }

# On Linux with SELinux enforcing, the project folder is relabelled for the container.
Z=""
if command -v getenforce >/dev/null 2>&1 && [ "$(getenforce)" = Enforcing ]; then Z=":Z"; fi

remove() { podman rm -f "$NAME" >/dev/null 2>&1 || true; }
dev() {   # dev PODMAN-RUN-OPTION...
  remove
  podman run "$@" --name "$NAME" -p "$PORT:@PORT@" -v "$PWD:/app$Z" -v "$VOLUME:/app/node_modules" \
    -w /app -e NEXT_TELEMETRY_DISABLED=1 @NODE@ sh -c "npm install && npm run dev"
}

case "$CMD" in
  dev)     if [ -t 0 ]; then dev --rm -it; else dev --rm -i; fi ;;
  start)   dev -d > /dev/null
           echo "started: http://localhost:$PORT (output: ./podman-run.sh logs)" ;;
  prod)    podman build -t "$NAME" .
           remove
           podman run -d --name "$NAME" -p "$PORT:@PORT@" -e HOSTNAME=0.0.0.0 "$NAME" > /dev/null
           echo "started: http://localhost:$PORT (output: ./podman-run.sh logs)" ;;
  logs)    podman logs -f "$NAME" ;;
  status)  podman ps -a --filter "name=^$NAME\$" ;;
  stop)    remove; echo "stopped $NAME" ;;
  cleanup) remove
           podman volume rm -f "$VOLUME" >/dev/null 2>&1 || true
           podman rmi -f "$NAME" >/dev/null 2>&1 || true
           echo "removed the container $NAME, the volume $VOLUME and the image $NAME" ;;
esac
EOF_FILE
  else
    put docker-compose.yml <<'EOF_FILE'
# The development server with live reload: docker compose up   (http://localhost:@PORT@)
services:
  docs:
    image: @NODE@
    working_dir: /app
    command: sh -c "npm install && npm run dev"
    ports:
      - "@PORT@:@PORT@"
    volumes:
      - .:/app
      - node_modules:/app/node_modules
    environment:
      - NEXT_TELEMETRY_DISABLED=1

volumes:
  node_modules:
EOF_FILE
  fi

  {
    cat <<'EOF_FILE'
# @NAME@

A documentation site built with [Nextra](https://nextra.site) 4 and Next.js.

## Run it

It needs Node.js 20.9 or newer.

```bash
npm install
npm run dev      # http://localhost:@PORT@, reloads when a file is saved
npm run build    # the production build and the search index
npm run start    # serves the production build
```

EOF_FILE
    if [ "$PODMAN" = 1 ]; then
      cat <<'EOF_FILE'
## Run it in a container (Podman)

```bash
./podman-run.sh          # the development server, in the foreground
./podman-run.sh start    # the same, in the background
./podman-run.sh prod     # build the production image and run it
./podman-run.sh logs     # follow the output
./podman-run.sh status
./podman-run.sh stop
./podman-run.sh cleanup  # also remove the dependencies volume and the image
```

EOF_FILE
    else
      cat <<'EOF_FILE'
## Run it in a container (Docker)

```bash
docker compose up                        # the development server
docker build -t @NAME@ .                 # the production image
docker run --rm -p @PORT@:@PORT@ @NAME@
```

EOF_FILE
    fi
    cat <<'EOF_FILE'
## Versions

`package.json` fixes the versions this project was generated with. Its `overrides` entry
holds zod at 4.1.12, because Nextra 4.6.1 does not build with zod 4.6.7 ("Invalid input:
expected nonoptional"). Remove that entry when you move to a newer Nextra.

## Write pages

- A page is an `.mdx` file in `content/`: `content/docs/my-page.mdx` is served as `/docs/my-page`.
- `_meta.js` in each folder sets the order and the titles in the sidebar.
- The title, the logo and the footer are in `app/layout.jsx`.

## Resources

- [Nextra](https://nextra.site)
- [Next.js](https://nextjs.org/docs)
- [MDX](https://mdxjs.com)
EOF_FILE
  } | put README.md || exit 1
}

MODE='list'
FILES="$(generate)"
total=0
replaced=0
plan=""
while IFS= read -r f; do
  total=$((total + 1))
  if [ -e "$DIR/$f" ]; then
    replaced=$((replaced + 1))
    plan="$plan  replace  $f
"
  else
    plan="$plan  create   $f
"
  fi
done <<EOF_LIST
$FILES
EOF_LIST

SHOWN="${DIR#./}"
CD="cd $(printf '%q' "$SHOWN")"
if [ "$DRY" = 1 ]; then
  echo "Would write $total files into $SHOWN ($replaced of them replace a file that is there):"
  printf '%s' "$plan"
  [ "$INSTALL" = 0 ] || echo "Would then run: npm install (in $SHOWN)"
  exit 0
fi

if [ -d "$DIR" ] && [ -n "$(ls -A -- "$DIR")" ]; then
  confirm "$SHOWN is not empty. Write $total files into it, replacing $replaced of its files?" ||
    die "nothing written"
fi

MODE='write'
generate
[ "$PODMAN" = 0 ] || chmod +x "$DIR/podman-run.sh" || die "cannot make podman-run.sh executable"

say() { [ "$QUIET" = 1 ] || echo "$*"; }
say "Wrote $total files into $SHOWN (project name: $NAME, port: $PORT)."

if [ "$INSTALL" = 1 ]; then
  say "Running npm install in $SHOWN ..."
  if [ "$QUIET" = 1 ]; then
    (cd -- "$DIR" && npm install > /dev/null)
  else
    (cd -- "$DIR" && npm install)
  fi || die "npm install failed in $SHOWN (the files are written; run it there again)"
  say "Next:  $CD && npm run dev      (http://localhost:$PORT)"
else
  say "Next:  $CD && npm install && npm run dev      (http://localhost:$PORT)"
fi
if [ "$PODMAN" = 1 ]; then
  say "  or:  $CD && ./podman-run.sh"
else
  say "  or:  $CD && docker compose up"
fi
