#!/bin/bash

# Function to rename the file
rename_file() {
    local old_file="$1"
    local new_filename="$2"
    
    echo "Renaming $old_file to '$(dirname "$old_file")/$new_filename'"
    mv "$old_file" "$(dirname "$old_file")/$new_filename"
}

# Ask for the directory if not provided as an argument
if [ -z "$1" ]; then
    read -p "Enter the directory path: " directory_path
else
    directory_path="$1"
fi

# Check if the provided path is a valid directory
if [ ! -d "$directory_path" ]; then
    echo "Invalid directory path."
    exit 1
fi

# Find all .md files in the directory
find "$directory_path" -type f -name "*.md" | while read -r file; do
    # Extract the filename without extension
    filename=$(basename "$file" .md)
    
    # Check if the filename matches the date pattern
    if [[ $filename =~ ^([0-9]{2})([0-9]{2})([0-9]{4})$ ]]; then
        day="${BASH_REMATCH[1]}"
        month="${BASH_REMATCH[2]}"
        year="${BASH_REMATCH[3]}"
        
        # Construct the new filename
        new_filename="${year}${month}${day}.md"
        
        # Rename the file
        rename_file "$file" "$new_filename"
    fi
done
