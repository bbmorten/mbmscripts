#!/bin/bash

if [ $# -eq 2 ]; then
    SRC="$1"
    DST="$2"
elif [ $# -eq 4 ]; then
    SRC="$1"
    DST="$2"
    USER="$3"
    HOST="$4"
else
    echo "Usage: $0 source_folder destination_folder [remote_username remote_host]"
    exit 1
fi

if [ -z "$USER" ] || [ -z "$HOST" ]; then
    while inotifywait -r "$SRC"; do
        rsync -avz --delete --inplace "$SRC" "$DST"
    done
else
    while inotifywait -r "$SRC"; do
        rsync -avz --delete --inplace "$SRC" "$USER"@"$HOST":"$DST"
    done
fi
