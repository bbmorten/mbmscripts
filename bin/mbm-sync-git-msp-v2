#!/usr/bin/env bash
#
# mbm-sync-git-msp-v2 — Sync local git-msp folder to remote host via rsync
#
# Usage:
#   mbm-sync-git-msp-v2              # normal sync with live progress
#   mbm-sync-git-msp-v2 --dry-run    # preview changes, don't touch anything
#   mbm-sync-git-msp-v2 --watch      # auto-sync on file changes (requires fswatch)
#   mbm-sync-git-msp-v2 --history    # show sync history from CSV
#   mbm-sync-git-msp-v2 --help       # show help
#

set -euo pipefail

# ─── Configuration ──────────────────────────────────────────────────────────
SOURCE_DIR="${MBM_SYNC_SOURCE_DIR:-$HOME/git-msp/}"
REMOTE_USER="${MBM_REMOTE_USER:-$USER}"
REMOTE_HOST="${MBM_SYNC_V2_REMOTE_HOST:-${MBM_REMOTE_HOST:-}}"
REMOTE_DIR="${MBM_SYNC_REMOTE_DIR:-git-msp/}"

# SSH options (uncomment and adjust if needed)
# SSH_PORT=22
# SSH_KEY="$HOME/.ssh/id_ed25519"
# SSH_OPTS="-e \"ssh -p ${SSH_PORT} -i ${SSH_KEY}\""

# Log directory and files
LOG_DIR="$HOME/.local/log/sync-git-msp"
LOG_FILE="${LOG_DIR}/sync-$(date +%Y-%m-%d).log"
STATS_CSV="${LOG_DIR}/stats.csv"

# Exclude patterns
EXCLUDES=(
  --exclude='.git/'
  --exclude='node_modules/'
  --exclude='.next/'
  --exclude='.nuxt/'
  --exclude='dist/'
  --exclude='build/'
  --exclude='out/'
  --exclude='__pycache__/'
  --exclude='*.pyc'
  --exclude='.venv/'
  --exclude='venv/'
  --exclude='.env'
  --exclude='.env.local'
  --exclude='vendor/'
  --exclude='.DS_Store'
  --exclude='*.log'
  --exclude='.idea/'
  --exclude='.vscode/'
  --exclude='coverage/'
  --exclude='.cache/'
)

# ─── Helpers ────────────────────────────────────────────────────────────────
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
BLUE=$'\033[0;34m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
NC=$'\033[0m'

log() {
  local level="$1"; shift
  local msg="$*"
  local ts
  ts="$(date '+%Y-%m-%d %H:%M:%S')"
  local color="$NC"
  case "$level" in
    INFO)  color="$BLUE"   ;;
    OK)    color="$GREEN"  ;;
    WARN)  color="$YELLOW" ;;
    ERROR) color="$RED"    ;;
    STAT)  color="$CYAN"   ;;
  esac
  printf '%s[%s] [%s]%s %s\n' "$color" "$ts" "$level" "$NC" "$msg"
  printf '[%s] [%s] %s\n' "$ts" "$level" "$msg" >> "$LOG_FILE"
}

show_help() {
  cat <<EOF
mbm-sync-git-msp-v2 — Sync ${SOURCE_DIR} → ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}

Usage:
  $0              Normal sync with live progress and stats
  $0 --dry-run    Preview changes without modifying anything
  $0 --watch      Continuously watch for changes and auto-sync (needs fswatch)
  $0 --history    Show last 20 sync runs from stats history
  $0 --help       Show this help

Logs:   ${LOG_DIR}/sync-YYYY-MM-DD.log
Stats:  ${STATS_CSV}
EOF
}

# Initialize the stats CSV with a header if it doesn't exist
init_stats_csv() {
  if [[ ! -f "$STATS_CSV" ]]; then
    echo "timestamp,duration_sec,files_total,files_transferred,files_deleted,bytes_total,bytes_sent,bytes_received,transfer_rate,speedup,exit_code" > "$STATS_CSV"
  fi
}

# Convert a byte count to human-readable (KB/MB/GB)
human_bytes() {
  local b="${1:-0}"
  b="${b//[^0-9.]/}"
  [[ -z "$b" || "$b" == "0" ]] && { echo "0 B"; return; }
  awk -v b="$b" 'BEGIN {
    split("B KB MB GB TB", u);
    i = 1;
    while (b >= 1024 && i < 5) { b /= 1024; i++ }
    printf "%.2f %s", b, u[i]
  }'
}

# Parse rsync --stats output and append a row to the CSV
parse_and_record_stats() {
  local out="$1"
  local duration="$2"
  local rc="$3"
  local ts
  ts="$(date '+%Y-%m-%d %H:%M:%S')"

  local files_total files_xferred files_deleted bytes_total bytes_sent bytes_recv rate speedup

  # Use awk to pull each value, stripping commas
  files_total=$(awk -F'[:,]' '/^Number of files:/ {gsub(/[^0-9]/,"",$2); print $2; exit}' "$out" 2>/dev/null)
  files_xferred=$(awk -F':' '/^Number of regular files transferred:/ {gsub(/[^0-9]/,"",$2); print $2; exit}' "$out" 2>/dev/null)
  files_deleted=$(awk -F':' '/^Number of deleted files:/ {gsub(/[^0-9]/,"",$2); print $2; exit}' "$out" 2>/dev/null)
  bytes_total=$(awk -F':' '/^Total file size:/ {gsub(/[^0-9]/,"",$2); print $2; exit}' "$out" 2>/dev/null)
  bytes_sent=$(awk -F':' '/^Total bytes sent:/ {gsub(/[^0-9]/,"",$2); print $2; exit}' "$out" 2>/dev/null)
  bytes_recv=$(awk -F':' '/^Total bytes received:/ {gsub(/[^0-9]/,"",$2); print $2; exit}' "$out" 2>/dev/null)

  # "sent X bytes  received Y bytes  Z bytes/sec"
  rate=$(awk '/bytes\/sec$/ {gsub(/,/,"",$(NF-1)); print $(NF-1); exit}' "$out" 2>/dev/null)

  # "total size is X  speedup is Y"
  speedup=$(awk '/speedup is/ {for(i=1;i<=NF;i++) if($i=="is" && $(i-1)=="speedup") {print $(i+1); exit}}' "$out" 2>/dev/null)

  : "${files_total:=0}"
  : "${files_xferred:=0}"
  : "${files_deleted:=0}"
  : "${bytes_total:=0}"
  : "${bytes_sent:=0}"
  : "${bytes_recv:=0}"
  : "${rate:=0}"
  : "${speedup:=0}"

  echo "${ts},${duration},${files_total},${files_xferred},${files_deleted},${bytes_total},${bytes_sent},${bytes_recv},${rate},${speedup},${rc}" >> "$STATS_CSV"

  local rate_human sent_human recv_human total_human
  rate_human=$(human_bytes "$rate")
  sent_human=$(human_bytes "$bytes_sent")
  recv_human=$(human_bytes "$bytes_recv")
  total_human=$(human_bytes "$bytes_total")

  log STAT "─── Run Summary ───"
  log STAT "  Duration:           ${duration}s"
  log STAT "  Files scanned:      ${files_total}"
  log STAT "  Files transferred:  ${files_xferred}"
  log STAT "  Files deleted:      ${files_deleted}"
  log STAT "  Total size:         ${total_human}"
  log STAT "  Bytes sent:         ${sent_human}"
  log STAT "  Bytes received:     ${recv_human}"
  log STAT "  Avg throughput:     ${rate_human}/s"
  log STAT "  Speedup ratio:      ${speedup}x"
}

show_history() {
  if [[ ! -f "$STATS_CSV" ]]; then
    log WARN "No history yet at $STATS_CSV"
    exit 0
  fi
  echo
  printf '%sLast 20 sync runs%s (from %s)\n\n' "$BOLD" "$NC" "$STATS_CSV"
  {
    echo "TIMESTAMP|DUR(s)|XFER|DEL|SENT|RATE/s|RC"
    tail -n 20 "$STATS_CSV" | awk -F',' 'NR>0 && $1 != "timestamp" {
      split("B KB MB GB TB", u)
      sent = $7; i=1; while (sent>=1024 && i<5) { sent/=1024; i++ }
      rate = $9; j=1; while (rate>=1024 && j<5) { rate/=1024; j++ }
      printf "%s|%s|%s|%s|%.1f %s|%.1f %s|%s\n", $1, $2, $4, $5, sent, u[i], rate, u[j], $11
    }'
  } | column -t -s '|'
  echo
}

run_sync() {
  local extra_flags=("$@")
  local stats_tmp
  stats_tmp=$(mktemp -t rsync-stats.XXXXXX)

  # NOTE: --info=progress2 gives the single-line live "throughput graph"
  # showing bytes transferred, percentage, throughput, and ETA.
  # We drop -v in favor of progress2 so the live display stays clean.
  local rsync_cmd=(
    rsync
    -az
    --human-readable
    --stats
    --info=progress2
    --delete
    "${EXCLUDES[@]}"
    "${extra_flags[@]}"
    "$SOURCE_DIR"
    "${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}"
  )

  log INFO "Starting rsync: ${SOURCE_DIR} → ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}"
  log INFO "Command: ${rsync_cmd[*]}"

  local start_ts end_ts duration rc
  start_ts=$(date +%s)

  # Tee live output to terminal, daily log, and a temp file we'll parse
  set +e
  "${rsync_cmd[@]}" 2>&1 | tee -a "$stats_tmp" "$LOG_FILE"
  rc=${PIPESTATUS[0]}
  set -e

  end_ts=$(date +%s)
  duration=$((end_ts - start_ts))

  parse_and_record_stats "$stats_tmp" "$duration" "$rc"
  rm -f "$stats_tmp"

  if [[ "$rc" -eq 0 ]]; then
    log OK "Sync completed successfully in ${duration}s"
  else
    log ERROR "Sync failed with exit code ${rc} after ${duration}s"
  fi
  return "$rc"
}

watch_mode() {
  if ! command -v fswatch >/dev/null 2>&1; then
    log ERROR "fswatch is required for --watch mode. Install with: brew install fswatch"
    exit 1
  fi

  log INFO "Watch mode active. Monitoring ${SOURCE_DIR} for changes... (Ctrl+C to stop)"

  run_sync || log WARN "Initial sync failed, continuing to watch..."

  fswatch -o \
    --exclude='\.git/' \
    --exclude='node_modules/' \
    --exclude='\.next/' \
    --exclude='dist/' \
    --exclude='build/' \
    --exclude='__pycache__/' \
    --exclude='\.venv/' \
    --exclude='\.DS_Store' \
    "$SOURCE_DIR" \
  | while read -r _; do
      log INFO "Change detected, syncing..."
      run_sync || log WARN "Sync failed, will retry on next change"
    done
}

if [[ -z "$REMOTE_HOST" && "${1:-}" != "-h" && "${1:-}" != "--help" ]]; then
  echo "No remote host is set. Export MBM_REMOTE_HOST (for example in the local.env file of your installation)." >&2
  exit 1
fi

# ─── Main ───────────────────────────────────────────────────────────────────
mkdir -p "$LOG_DIR"
init_stats_csv

if [[ ! -d "$SOURCE_DIR" ]]; then
  log ERROR "Source directory does not exist: $SOURCE_DIR"
  exit 1
fi

case "${1:-}" in
  -h|--help)
    show_help
    ;;
  -n|--dry-run)
    log INFO "DRY RUN — no changes will be made"
    run_sync --dry-run
    ;;
  -w|--watch)
    watch_mode
    ;;
  --history)
    show_history
    ;;
  '')
    run_sync
    ;;
  *)
    log ERROR "Unknown option: $1"
    show_help
    exit 1
    ;;
esac
